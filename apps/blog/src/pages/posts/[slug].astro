---
import { getCollection, render } from 'astro:content';
import SiteLayout from '@nyameko/ui/SiteLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<SiteLayout title={post.data.title} siteName="Astro · Blog" section="Blog" description={post.data.description}>
  <article class="article container">
    <header>
      <p class="eyebrow">{post.data.pubDate.toLocaleDateString()}</p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
    </header>
    <div class="prose"><Content /></div>
  </article>
</SiteLayout>

<style>
  .article {
    max-width: 820px;
    padding-top: 6rem;
  }
  h1 {
    margin: 0.6rem 0 0;
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  .prose {
    margin-top: 3.5rem;
    color: var(--muted-strong);
    font-size: 1.08rem;
  }
  .prose :global(h2) { margin-top: 2.5rem; color: var(--text); }
  .prose :global(a) { color: var(--purple); }
  .prose :global(code) { color: var(--purple); }
</style>
