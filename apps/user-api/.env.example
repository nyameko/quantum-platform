# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:4323
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

# Astro User Portal
PORTAL_BASE_URL=http://127.0.0.1:4323

# PostgreSQL
POSTGRES_DB=quantum_platform
POSTGRES_USER=quantum_platform
POSTGRES_PASSWORD=development-only-change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Email: console backend for local development.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=Quantum Platform <noreply@nyameko.com>

# SMTP production examples:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.org
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
