---
import SiteLayout from '@nyameko/ui/SiteLayout.astro';
---

<SiteLayout
  title="Reset password"
  siteName="Quantum Platform"
  section="User Portal"
>
  <section class="auth-shell container">
    <div class="auth-card">
      <p class="eyebrow">ACCOUNT SECURITY</p>
      <h1>Reset your password</h1>

      <form id="reset-form">
        <label>
          Email
          <input
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </label>

        <button type="submit">Send reset link</button>
        <p id="message" role="status"></p>
      </form>
    </div>
  </section>
</SiteLayout>

<script>
  import {
    csrfJsonFetch,
    readPayload,
  } from '../../../lib/auth';

  const form = document.querySelector<HTMLFormElement>('#reset-form');
  const message = document.querySelector<HTMLParagraphElement>('#message');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const data = new FormData(form);

    const response = await csrfJsonFetch(
      '/_allauth/browser/v1/auth/password/request',
      {
        method: 'POST',
        body: JSON.stringify({
          email: data.get('email'),
        }),
      },
    );

    await readPayload(response);

    if (message) {
      message.textContent = (
        'If an account exists for that address, '
        + 'a password-reset email has been sent.'
      );
    }
  });
</script>

<style>
  .auth-shell {
    min-height: 65vh;
    display: grid;
    place-items: center;
  }

  .auth-card {
    width: min(100%, 32rem);
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
  }

  form {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  label {
    display: grid;
    gap: 0.45rem;
  }

  input {
    padding: 0.8rem;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    background: var(--background);
    color: var(--text);
  }

  button {
    min-height: 2.8rem;
    border: 0;
    border-radius: 0.65rem;
    background: var(--purple-strong);
    color: white;
    font-weight: 700;
  }
</style>
