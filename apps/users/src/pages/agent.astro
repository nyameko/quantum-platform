---
import SiteLayout from '@nyameko/ui/SiteLayout.astro';
---

<SiteLayout title="Personal Agent" siteName="Quantum Platform" section="User Portal">
  <section class="section container page-shell">
    <div class="assistant-shell" id="assistant-shell">
      <aside class="assistant-sidebar" id="assistant-sidebar" aria-label="Research assistant navigation">
        <div class="sidebar-brand">
          <strong>Quantum Guide</strong>
          <span>Research assistant</span>
        </div>
        <button id="new-chat" type="button" class="new-chat">💬 New chat</button>

        <div class="sidebar-section-heading">
          <h2>Projects</h2>
          <button id="add-project" type="button" class="icon-control" title="Create project" aria-label="Create project">+</button>
        </div>
        <form id="project-form" hidden>
          <label for="project-title">Project name</label>
          <input id="project-title" maxlength="200" placeholder="e.g. Quantum foundations" required />
          <div class="compact-actions">
            <button type="submit">Create</button>
            <button id="cancel-project" type="button" class="secondary">Cancel</button>
          </div>
        </form>
        <nav id="project-tree" aria-label="Projects and conversations"></nav>
        <div class="sidebar-section-heading"><h2>Recent chats</h2></div>
        <nav id="unfiled-chats" aria-label="Unfiled conversations"></nav>
      </aside>

      <main class="assistant-main">
        <header class="conversation-heading">
          <div>
            <p class="eyebrow">RESEARCH ASSISTANT · CANONICAL ACP CONVERSATION</p>
            <h1 id="active-title">Choose a conversation</h1>
          </div>
          <div class="heading-actions">
            <button id="toggle-sidebar" type="button" class="secondary icon-control" aria-label="Toggle navigation sidebar" aria-expanded="true" title="Toggle navigation">☰</button>
            <button id="toggle-width" type="button" class="secondary icon-control" aria-pressed="false" aria-label="Expand reading area" title="Expand reading area">⤢</button>
            <button id="refresh" type="button" class="secondary" title="Refresh conversation and memories">Refresh</button>
          </div>
        </header>

        <div id="transcript" class="transcript" aria-live="polite">
          <p class="empty">Start a new chat or choose a conversation.</p>
        </div>

        <form id="turn-form" class="composer">
          <label for="message" class="sr-only">Message</label>
          <textarea id="message" rows="3" placeholder="Ask about quantum computing, HPC, or your research…"></textarea>
          <div class="composer-footer">
            <small class="send-shortcut-hint">Ctrl+Enter (⌘+Enter on Mac) sends · Enter inserts a new line</small>
            <button id="send" type="submit">Send</button>
          </div>
        </form>
        <p id="status" role="status" aria-live="polite"></p>

    <details class="panel memory-panel" id="memory-details">
      <summary>Research memories <span class="memory-summary-hint">Review approved preferences and notes</span></summary>
      <div class="memory-content">
      <div class="conversation-heading">
        <div>
          <p class="eyebrow">M4B · USER-APPROVED MEMORY</p>
          <h2 id="memory-heading">Your research memories</h2>
        </div>
        <button id="refresh-memories" type="button" class="secondary">Reload memories</button>
      </div>
      <p class="note">
        Use “Remember this” on one of your messages, review the proposed summary,
        and approve it explicitly. Only approved memories can be used in later sessions.
      </p>
      <form id="memory-form">
        <p id="memory-source" class="note" aria-live="polite">
          Choose “Remember this” beside a message you wrote.
        </p>
        <label>
          What should the assistant remember?
          <textarea id="memory-body" rows="3" maxlength="2000"
            placeholder="An accurate, reusable research preference or fact. Do not include secrets."></textarea>
        </label>
        <label>
          Memory category
          <select id="memory-kind">
            <option value="preference">Research preference</option>
            <option value="episodic">Research session note</option>
            <option value="semantic">Research fact or concept</option>
            <option value="project_note">Project note (private)</option>
          </select>
        </label>
        <button id="propose-memory" type="submit" disabled>Propose memory for review</button>
      </form>
      <p id="memory-status" role="status" aria-live="polite"></p>
      <div id="memory-list" class="memory-list">
        <p class="empty">Loading your memory records…</p>
      </div>
      </div>
    </details>

    <p class="note">
      Research memories remain private and require approval. Their use by Hermes
      is separately controlled by ACP deployment settings; saving a memory does not
      guarantee it has been enabled for inference. Skills and the polished Guide
      remain separate roadmap milestones.
    </p>
      </main>
    </div>
  </section>
</SiteLayout>

<script>
  import { csrfJsonFetch, requireSession } from '../lib/auth';

  type Project = { id: string; title: string };
  type Conversation = { id: string; project_id?: string | null; title: string };
  type MemoryItem = {
    id: string;
    status: 'candidate' | 'active' | 'revoked';
    revision: number;
    kind: string;
    body: string | null;
    source_conversation_id: string;
    source_message_id: string;
  };

  type Message = {
    id: string;
    author_kind: string;
    content: unknown;
    sequence: number;
  };

  const shell = document.querySelector<HTMLElement>('#assistant-shell');
  const projectTree = document.querySelector<HTMLElement>('#project-tree');
  const unfiledChats = document.querySelector<HTMLElement>('#unfiled-chats');
  const newChat = document.querySelector<HTMLButtonElement>('#new-chat');
  const addProject = document.querySelector<HTMLButtonElement>('#add-project');
  const cancelProject = document.querySelector<HTMLButtonElement>('#cancel-project');
  const projectForm = document.querySelector<HTMLFormElement>('#project-form');
  const projectTitle = document.querySelector<HTMLInputElement>('#project-title');
  const toggleSidebar = document.querySelector<HTMLButtonElement>('#toggle-sidebar');
  const toggleWidth = document.querySelector<HTMLButtonElement>('#toggle-width');
  const memoryDetails = document.querySelector<HTMLDetailsElement>('#memory-details');
  const activeTitle = document.querySelector<HTMLElement>('#active-title');
  const transcript = document.querySelector<HTMLElement>('#transcript');
  const turnForm = document.querySelector<HTMLFormElement>('#turn-form');
  const message = document.querySelector<HTMLTextAreaElement>('#message');
  const send = document.querySelector<HTMLButtonElement>('#send');
  const status = document.querySelector<HTMLParagraphElement>('#status');
  const refresh = document.querySelector<HTMLButtonElement>('#refresh');
  const memoryForm = document.querySelector<HTMLFormElement>('#memory-form');
  const memoryBody = document.querySelector<HTMLTextAreaElement>('#memory-body');
  const memoryKind = document.querySelector<HTMLSelectElement>('#memory-kind');
  const memorySource = document.querySelector<HTMLElement>('#memory-source');
  const memoryStatus = document.querySelector<HTMLElement>('#memory-status');
  const memoryList = document.querySelector<HTMLElement>('#memory-list');
  const proposeMemory = document.querySelector<HTMLButtonElement>('#propose-memory');
  const refreshMemories = document.querySelector<HTMLButtonElement>('#refresh-memories');

  let sourceConversationId: string | null = null;
  let sourceMessageId: string | null = null;


  let activeProject: string | null = null;
  let activeConversation: string | null = null;
  // Session-local pointer only; ACP's authenticated run record remains canonical.
  // Never persist bearer tokens or model output in browser storage.
  const runKey = (conversationId: string) => 'qp:personal-run:' + conversationId;
  let pollingGeneration = 0;
  function rememberRun(conversationId: string, runId: string) {
    window.sessionStorage.setItem(runKey(conversationId), runId);
  }
  function clearRememberedRun(conversationId: string, runId: string) {
    if (window.sessionStorage.getItem(runKey(conversationId)) === runId) {
      window.sessionStorage.removeItem(runKey(conversationId));
    }
  }


  function displayContent(value: unknown): string {
    if (typeof value === 'string') return value;

    if (
      value
      && typeof value === 'object'
      && 'text' in value
      && typeof (value as { text?: unknown }).text === 'string'
    ) {
      return (value as { text: string }).text;
    }

    return JSON.stringify(value);
  }

  let availableProjects: Project[] = [];
  let availableConversations: Conversation[] = [];
  const closedFolders = new Set<string>();

  function appendChat(parent: HTMLElement, chat: Conversation) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'sidebar-chat' + (chat.id === activeConversation ? ' selected' : '');
    button.textContent = chat.title || 'New chat';
    button.title = chat.title || 'New chat';
    if (chat.id === activeConversation) button.setAttribute('aria-current', 'page');
    button.addEventListener('click', () => void selectConversation(chat));
    parent.append(button);
  }

  function renderSidebar() {
    if (!projectTree || !unfiledChats) return;
    projectTree.replaceChildren();
    unfiledChats.replaceChildren();

    for (const project of availableProjects) {
      const group = document.createElement('div');
      group.className = 'project-group';
      const header = document.createElement('div');
      header.className = 'project-header';
      const fold = document.createElement('button');
      fold.type = 'button';
      fold.className = 'folder-name';
      const open = !closedFolders.has(project.id);
      fold.textContent = (open ? '▾ 📂 ' : '▸ 📁 ') + project.title;
      fold.setAttribute('aria-expanded', String(open));
      fold.title = project.title;
      const children = document.createElement('div');
      children.className = 'project-children';
      children.hidden = !open;
      fold.addEventListener('click', () => {
        if (closedFolders.has(project.id)) closedFolders.delete(project.id);
        else closedFolders.add(project.id);
        renderSidebar();
      });
      const add = document.createElement('button');
      add.type = 'button';
      add.className = 'icon-control secondary';
      add.textContent = '+';
      add.title = 'New chat in ' + project.title;
      add.setAttribute('aria-label', add.title);
      add.addEventListener('click', () => void createConversation(project.id));
      header.append(fold, add);
      availableConversations.filter(c => c.project_id === project.id)
        .forEach(chat => appendChat(children, chat));
      group.append(header, children);
      projectTree.append(group);
    }
    const other = availableConversations.filter(c => !c.project_id);
    other.forEach(chat => appendChat(unfiledChats, chat));
    if (!other.length) {
      const empty = document.createElement('small');
      empty.className = 'small-note';
      empty.textContent = 'No unfiled chats';
      unfiledChats.append(empty);
    }
  }

  async function loadSidebar(preferredId?: string) {
    const [projectResponse, conversationResponse] = await Promise.all([
      fetch('/api/v1/agent/projects/', { credentials: 'same-origin', cache: 'no-store' }),
      fetch('/api/v1/agent/conversations/', { credentials: 'same-origin', cache: 'no-store' }),
    ]);
    if (!projectResponse.ok || !conversationResponse.ok) {
      if (status) status.textContent = 'Unable to load projects or conversations.';
      return;
    }
    const projectData = await projectResponse.json();
    const conversationData = await conversationResponse.json();
    availableProjects = projectData.items ?? [];
    availableConversations = conversationData.items ?? [];
    const requested = preferredId ?? activeConversation
      ?? window.sessionStorage.getItem('qp:last-conversation-id');
    const selected = availableConversations.find(c => c.id === requested)
      ?? availableConversations[0];
    activeConversation = selected?.id ?? null;
    activeProject = selected?.project_id ?? null;
    renderSidebar();
    await loadConversation();
  }

  async function selectConversation(chat: Conversation) {
    pollingGeneration += 1;
    activeConversation = chat.id;
    activeProject = chat.project_id ?? null;
    window.sessionStorage.setItem('qp:last-conversation-id', chat.id);
    renderSidebar();
    await loadConversation();
  }

  async function createConversation(projectId: string | null = null): Promise<boolean> {
    if (newChat) newChat.disabled = true;
    try {
      const response = await csrfJsonFetch('/api/v1/agent/conversations/', {
        method: 'POST',
        body: JSON.stringify({ title: 'New chat', ...(projectId ? { project_id: projectId } : {}) }),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.detail ?? 'Unable to create conversation.');
      activeConversation = payload.id;
      activeProject = payload.project_id ?? null;
      window.sessionStorage.setItem('qp:last-conversation-id', payload.id);
      await loadSidebar(payload.id);
      message?.focus();
      return true;
    } catch (error) {
      if (status) status.textContent =
        error instanceof Error ? error.message : 'Unable to create conversation.';
      return false;
    } finally {
      if (newChat) newChat.disabled = false;
    }
  }

  function renderMessages(items: Message[]) {
    if (!transcript) return;

    transcript.replaceChildren();

    if (!items.length) {
      const empty = document.createElement('p');
      empty.className = 'empty';
      empty.textContent = 'No messages yet.';
      transcript.append(empty);
      return;
    }

    for (const item of items) {
      const article = document.createElement('article');
      article.className = 'message ' + item.author_kind;

      const role = document.createElement('strong');
      role.textContent = item.author_kind === 'assistant' ? 'Agent' : 'You';

      const body = document.createElement('p');
      body.textContent = displayContent(item.content);

      article.append(role, body);
      if (item.author_kind === 'user' && activeConversation) {
        const remember = document.createElement('button');
        remember.type = 'button';
        remember.className = 'secondary remember-action';
        remember.textContent = 'Remember this';
        remember.addEventListener('click', () => {
          sourceConversationId = activeConversation;
          if (memoryDetails) memoryDetails.open = true;
          sourceMessageId = item.id;
          if (memoryBody) memoryBody.value = displayContent(item.content).slice(0, 2000);
          if (memorySource) {
            memorySource.textContent = 'Source: this message in the current conversation.';
          }
          if (proposeMemory) proposeMemory.disabled = false;
          memoryBody?.focus();
        });
        article.append(remember);
      }
      transcript.append(article);
    }

    transcript.scrollTop = transcript.scrollHeight;
  }

  async function loadConversation() {
    sourceConversationId = null;
    sourceMessageId = null;
    if (proposeMemory) proposeMemory.disabled = true;
    if (memorySource) {
      memorySource.textContent = 'Choose “Remember this” beside a message you wrote.';
    }
    if (!activeConversation) {
      if (activeTitle) activeTitle.textContent = 'New research conversation';
      renderMessages([]);
      return;
    }

    const path = '/api/v1/agent/conversations/' + activeConversation + '/';
    const response = await fetch(path, {
      credentials: 'same-origin',
      cache: 'no-store',
    });
    const payload = await response.json().catch(() => ({}));

    if (!response.ok) {
      if (status) status.textContent = payload.detail ?? 'Unable to load conversation.';
      return;
    }

    if (activeTitle) activeTitle.textContent = payload.title ?? 'Conversation';
    renderMessages(payload.messages ?? []);
    await refreshRunStatus(activeConversation);
  }

  async function refreshRunStatus(conversationId: string) {
    const runId = window.sessionStorage.getItem(runKey(conversationId));
    if (!runId || conversationId !== activeConversation) return;
    const response = await fetch('/api/v1/agent/runs/' + encodeURIComponent(runId) + '/', {
      credentials: 'same-origin',
      cache: 'no-store',
    });
    const run = await response.json().catch(() => ({}));
    if (conversationId !== activeConversation) return;
    if (!response.ok) {
      if (status) status.textContent = run.detail ?? 'Unable to read agent status.';
      // Do not delete the pointer for transient 503 failures.
      if (response.status === 403 || response.status === 404) {
        clearRememberedRun(conversationId, runId);
      }
      return;
    }
    if (run.conversation_id !== conversationId) {
      clearRememberedRun(conversationId, runId);
      if (status) status.textContent = 'Run does not belong to this conversation.';
      return;
    }
    if (run.status === 'succeeded') {
      clearRememberedRun(conversationId, runId);
      if (status) status.textContent = 'Response persisted.';
      return;
    }
    if (run.status === 'failed') {
      clearRememberedRun(conversationId, runId);
      if (status) status.textContent =
        'Agent run failed: ' + (run.failure_code ?? 'unknown error');
      return;
    }
    if (status) status.textContent = run.status === 'queued'
      ? 'Agent run queued…'
      : 'Agent is responding…';
  }

  async function pollRun(runId: string, conversationId: string) {
    const generation = ++pollingGeneration;
    for (let attempt = 0; attempt < 60; attempt += 1) {
      if (generation !== pollingGeneration || activeConversation !== conversationId) return;
      await refreshRunStatus(conversationId);
      if (window.sessionStorage.getItem(runKey(conversationId)) !== runId) return;
      await new Promise((resolve) => window.setTimeout(resolve, 1000));
    }
    if (status && conversationId === activeConversation) {
      status.textContent = 'Agent run is still active. Use Refresh to check its status.';
    }
  }

  async function loadMemories() {
    if (!memoryList) return;
    const response = await fetch('/api/v1/agent/memories/', {
      credentials: 'same-origin',
      cache: 'no-store',
    });
    const payload = await response.json().catch(() => ({}));
    memoryList.replaceChildren();

    if (!response.ok) {
      if (memoryStatus) {
        memoryStatus.textContent = response.status === 503
          ? 'Memory controls are not available until the ACP memory service is activated.'
          : (payload.detail ?? 'Unable to load memories.');
      }
      return;
    }

    const items: MemoryItem[] = payload.items ?? [];
    if (memoryStatus) {
      memoryStatus.textContent = 'Memory list refreshed · ' + items.length + ' record(s).';
    }
    if (!items.length) {
      const empty = document.createElement('p');
      empty.className = 'empty';
      empty.textContent = 'No saved memories. Choose a message above to get started.';
      memoryList.append(empty);
      return;
    }

    for (const item of items) {
      const article = document.createElement('article');
      article.className = 'memory-item';
      const heading = document.createElement('strong');
      heading.textContent = item.kind.replaceAll('_', ' ') + ' · ' + item.status;
      const detail = document.createElement('p');
      detail.textContent = item.body ?? 'Revoked — no longer available for retrieval.';
      const source = document.createElement('small');
      source.textContent = 'Source conversation ' + item.source_conversation_id
        + ', message ' + item.source_message_id + ' · revision ' + item.revision;
      article.append(heading, detail, source);

      if (item.status !== 'revoked') {
        const actions = document.createElement('div');
        actions.className = 'memory-actions';
        if (item.status === 'candidate') {
          const approve = document.createElement('button');
          approve.type = 'button';
          approve.textContent = 'Approve memory';
          approve.addEventListener('click', () => void changeMemory(item, 'approve'));
          actions.append(approve);
        }
        if (item.status === 'active' && item.body) {
          const edit = document.createElement('button');
          edit.type = 'button';
          edit.className = 'secondary';
          edit.textContent = 'Correct memory';
          edit.addEventListener('click', () => {
            if (article.querySelector('.memory-correction')) return;
            const form = document.createElement('form');
            form.className = 'memory-correction';
            const label = document.createElement('label');
            label.textContent = 'Corrected memory (requires your approval)';
            const field = document.createElement('textarea');
            field.rows = 3;
            field.maxLength = 2000;
            field.value = item.body ?? '';
            label.append(field);
            const formActions = document.createElement('div');
            formActions.className = 'memory-actions';
            const save = document.createElement('button');
            save.type = 'submit';
            save.textContent = 'Save correction';
            const cancel = document.createElement('button');
            cancel.type = 'button';
            cancel.className = 'secondary';
            cancel.textContent = 'Cancel';
            cancel.addEventListener('click', () => form.remove());
            const errorMessage = document.createElement('p');
            errorMessage.setAttribute('role', 'status');
            formActions.append(save, cancel);
            form.append(label, formActions, errorMessage);
            form.addEventListener('submit', async (event) => {
              event.preventDefault();
              const corrected = field.value.trim();
              if (!corrected || corrected.length > 2000) {
                errorMessage.textContent = 'Enter 1–2000 characters.';
                return;
              }
              save.disabled = true;
              cancel.disabled = true;
              try {
                const response = await csrfJsonFetch(
                  '/api/v1/agent/memories/' + item.id + '/',
                  {
                    method: 'PATCH',
                    headers: { 'If-Match': '"' + item.revision + '"' },
                    body: JSON.stringify({ body: corrected }),
                  },
                );
                const result = await response.json().catch(() => ({}));
                if (!response.ok) {
                  throw new Error(result.detail ?? 'Memory correction failed.');
                }
                await loadMemories();
                if (memoryStatus) {
                  memoryStatus.textContent = 'Memory corrected; previous revision retained for audit.';
                }
              } catch (error) {
                errorMessage.textContent = error instanceof Error
                  ? error.message : 'Unable to correct memory.';
              } finally {
                save.disabled = false;
                cancel.disabled = false;
              }
            });
            article.append(form);
            field.focus();
          });
          actions.append(edit);
        }
        const revoke = document.createElement('button');
        revoke.type = 'button';
        revoke.className = 'secondary';
        revoke.textContent = 'Revoke';
        revoke.addEventListener('click', () => void changeMemory(item, 'revoke'));
        actions.append(revoke);
        article.append(actions);
      }
      memoryList.append(article);
    }
  }

  async function changeMemory(item: MemoryItem, action: 'approve' | 'revoke') {
    if (!memoryList) return;
    const buttons = memoryList.querySelectorAll<HTMLButtonElement>('button');
    buttons.forEach((button) => { button.disabled = true; });
    if (memoryStatus) memoryStatus.textContent = 'Updating memory…';
    try {
      const response = await csrfJsonFetch(
        '/api/v1/agent/memories/' + item.id + '/' + action + '/',
        {
          method: 'POST',
          headers: { 'If-Match': '"' + item.revision + '"' },
          body: JSON.stringify({}),
        },
      );
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(payload.detail ?? 'Unable to update memory.');
      }
      await loadMemories();
      if (memoryStatus) {
        memoryStatus.textContent = action === 'approve'
          ? 'Memory approved for future retrieval.'
          : 'Memory revoked; it will not be retrieved again.';
      }
    } catch (error) {
      await loadMemories();
      if (memoryStatus) {
        memoryStatus.textContent = error instanceof Error ? error.message : 'Memory update failed.';
      }
    } finally {
      buttons.forEach((button) => { button.disabled = false; });
    }
  }

  memoryForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const body = memoryBody?.value.trim();
    if (!sourceConversationId || !sourceMessageId || !body || !proposeMemory) {
      if (memoryStatus) memoryStatus.textContent = 'Choose a source message and enter a memory.';
      return;
    }
    proposeMemory.disabled = true;
    if (memoryStatus) memoryStatus.textContent = 'Saving proposal…';
    try {
      const response = await csrfJsonFetch('/api/v1/agent/memories/', {
        method: 'POST',
        headers: { 'Idempotency-Key': crypto.randomUUID() },
        body: JSON.stringify({
          source_conversation_id: sourceConversationId,
          source_message_id: sourceMessageId,
          kind: memoryKind?.value ?? 'preference',
          body,
        }),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.detail ?? 'Memory proposal failed.');
      await loadMemories();
      if (memoryStatus) {
        memoryStatus.textContent = 'Proposal saved. Review it below and select Approve memory.';
      }
    } catch (error) {
      if (memoryStatus) {
        memoryStatus.textContent = error instanceof Error ? error.message : 'Memory proposal failed.';
      }
    } finally {
      proposeMemory.disabled = false;
    }
  });

  refreshMemories?.addEventListener('click', () => void loadMemories());

  addProject?.addEventListener('click', () => {
    if (projectForm) projectForm.hidden = false;
    projectTitle?.focus();
  });
  cancelProject?.addEventListener('click', () => {
    if (projectForm) projectForm.hidden = true;
  });
  projectForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const title = projectTitle?.value.trim();
    if (!title) return;
    const response = await csrfJsonFetch('/api/v1/agent/projects/', {
      method: 'POST', body: JSON.stringify({ title }),
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) {
      if (status) status.textContent = payload.detail ?? 'Unable to create project.';
      return;
    }
    if (projectForm) projectForm.hidden = true;
    if (projectTitle) projectTitle.value = '';
    await loadSidebar();
    // Creating a project does not create an unwanted empty conversation.
  });
  newChat?.addEventListener('click', () => void createConversation());
  toggleSidebar?.addEventListener('click', () => {
    const collapsed = shell?.classList.toggle('nav-collapsed') ?? false;
    toggleSidebar.setAttribute('aria-expanded', String(!collapsed));
  });
  toggleWidth?.addEventListener('click', () => {
    const wide = shell?.classList.toggle('reading-wide') ?? false;
    toggleWidth.setAttribute('aria-pressed', String(wide));
    toggleWidth.title = wide ? 'Restore reading width' : 'Expand reading area';
  });
  // Preserve multiline code and research prompts: Enter inserts a newline,
  // while Ctrl+Enter (or Cmd+Enter on macOS) submits the existing form.
  message?.addEventListener('keydown', (event) => {
    if (
      event.key !== 'Enter'
      || !(event.ctrlKey || event.metaKey)
      || event.shiftKey
      || event.altKey
      || event.repeat
      || event.isComposing
    ) return;

    event.preventDefault();
    if (!message.value.trim() || !activeConversation || send?.disabled) return;
    turnForm?.requestSubmit();
  });

  turnForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const content = message?.value.trim();

    if (!content || !send) return;
    if (!activeConversation && !await createConversation()) return;
    const submittedConversation = activeConversation;
    if (!submittedConversation) return;

    send.disabled = true;
    if (status) status.textContent = 'Agent run queued…';

    const idempotencyKey = crypto.randomUUID();
    const clientMessageId = crypto.randomUUID();

    try {
      const path = '/api/v1/agent/conversations/'
        + submittedConversation
        + '/turns/';
      const response = await csrfJsonFetch(path, {
        method: 'POST',
        headers: { 'Idempotency-Key': idempotencyKey },
        body: JSON.stringify({
          content: { text: content },
          source_channel: 'web',
          client_message_id: clientMessageId,
        }),
      });
      const payload = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(payload.detail ?? 'Unable to queue agent turn.');
      }

      if (message) message.value = '';
      await loadConversation();

      rememberRun(submittedConversation, payload.run_id);
      if (status) status.textContent = 'Agent is responding…';
      await pollRun(payload.run_id, submittedConversation);
      if (activeConversation === submittedConversation) await loadConversation();
    } catch (error) {
      if (status) {
        status.textContent = error instanceof Error
          ? error.message
          : 'Agent request failed.';
      }
    } finally {
      send.disabled = false;
    }
  });

  refresh?.addEventListener('click', async () => {
    await loadConversation();
    await loadMemories();
  });

  if (await requireSession()) {
    await loadSidebar();
    await loadMemories();

    // A mini-guide question from another portal page becomes a new canonical
    // conversation with a draft, not an auto-sent query or URL/log entry.
    const handoff = window.sessionStorage.getItem('qp:guide-draft');
    if (handoff) {
      const needsNew = window.sessionStorage.getItem('qp:guide-new-chat') === '1';
      if (!needsNew || await createConversation()) {
        if (message) {
          message.value = handoff;
          message.focus();
        }
        window.sessionStorage.removeItem('qp:guide-draft');
        window.sessionStorage.removeItem('qp:guide-new-chat');
      }
    }
  }
</script>

