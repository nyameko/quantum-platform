    width: 100%; min-height: 2.25rem; padding: .45rem .6rem;
    background: transparent; color: var(--text); font-weight: 500;
    text-align: left; overflow-wrap: anywhere;
  }
  .getting-started button:hover, .folder-name:hover, .sidebar-chat:hover {
    background: var(--background);
  }
  .sidebar-chat.selected { background: var(--background); font-weight: 700; }
  .workspace-menu-wrap { display:inline-flex; margin-left:auto; flex-shrink:0; }
  .workspace-menu { display:grid; place-items:center; flex-shrink:0; min-width:2.3rem; height:2.3rem;
    border:1px solid transparent; border-radius:.55rem; background:transparent; color:var(--text); cursor:pointer; }
  .workspace-menu:hover, .workspace-menu:focus-visible { border-color:var(--border); background:var(--background-soft); }
  .workspace-menu-actions:popover-open {
    position:fixed; inset:unset; z-index:1000;
    min-width:13rem; max-height:min(65vh,25rem); overflow-y:auto;
    padding:.35rem; display:grid; gap:.2rem; border:1px solid var(--border);
    border-radius:.6rem; color:var(--text); background:var(--surface);
    box-shadow:0 10px 30px rgb(0 0 0 / 35%);
  }
  .workspace-menu-actions button { display:block; width:100%; min-height:2.1rem; text-align:left;
    background:transparent; color:var(--text); font-weight:500; font-size:.8rem; }
  .workspace-menu-actions button:hover:not(:disabled) { background:var(--background); }
  .workspace-menu-actions button:disabled { opacity:.55; cursor:not-allowed; }
  .folder-name::before { content:''; display:inline-block; width:1rem; height:1rem; margin-right:.4rem;
    vertical-align:middle; background:currentColor; opacity:.55;
    mask:url('/assets/guide/folder.svg') center / contain no-repeat;
    -webkit-mask:url('/assets/guide/folder.svg') center / contain no-repeat; }
  .sidebar-chat::before { content:''; display:inline-block; width:1rem; height:1rem; margin-right:.4rem;
    vertical-align:middle; background:currentColor; opacity:.55;
    mask:url('/assets/guide/chat.svg') center / contain no-repeat;
    -webkit-mask:url('/assets/guide/chat.svg') center / contain no-repeat; }
  .archive-filter { display: flex; align-items: center; gap: .4rem; font-size: .75rem; margin: .6rem 0; }
  .archive-filter input, .workspace-archive-check input { width: auto; }
  .chat-row { display: flex; gap: .15rem; align-items: center; }
  .chat-row .sidebar-chat { flex: 1; min-width: 0; }
  .workspace-action { font-size: 1.15rem; min-height: 2.1rem; }
  .sidebar-section-heading, .project-header, .compact-actions, .heading-actions {
    display: flex; align-items: center; justify-content: space-between; gap: .4rem;
  }
  .sidebar-section-heading { margin-top: 1rem; }
  .sidebar-section-heading h2 { margin: 0; }
  .project-header { padding-top: .3rem; }
  .project-header .folder-name { flex: 1; min-width:0; text-overflow:ellipsis; overflow:hidden; white-space:nowrap; }
  .project-children { padding-left: .65rem; border-left: 1px solid var(--border); }
  .project-children[hidden], #project-form[hidden] { display: none; }
  .icon-control { min-width: 2.4rem; width: 2.4rem; padding: 0; text-align: center; }
  .assistant-main { min-width: 0; padding: 1rem; border: 1px solid var(--border); border-radius: 1rem; }
  h1 { margin: .3rem 0 0; font-size: clamp(1.15rem, 2vw, 1.6rem); letter-spacing: -.02em; }
  .panel { padding: 1rem; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); }
  .workspace-editor { width: min(90vw, 30rem); padding: 1.5rem; border: 1px solid var(--border);
    border-radius: 1rem; background: var(--surface); color: var(--text); }
