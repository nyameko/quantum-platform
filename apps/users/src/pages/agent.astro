    visibility: hidden;
    padding: 0;
    border: 0;
    overflow: hidden;
  }
  .sidebar-brand { display: grid; gap: .25rem; margin-bottom: 1rem; }
  .sidebar-brand strong { font-size: 1.2rem; }
