---
import SiteLayout from '@nyameko/ui/SiteLayout.astro';
---

<SiteLayout title="Personal Agent" siteName="Quantum Platform" section="User Portal">
  <section class="section container page-shell">
    <div class="assistant-shell nav-collapsed" id="assistant-shell">
      <aside class="assistant-sidebar" id="assistant-sidebar" aria-label="Research assistant navigation">
        <div class="sidebar-brand">
          <strong>Workspace management</strong>
          <span>Research assistant</span>
        </div>
        <button id="new-chat" type="button" class="new-chat">New chat</button>

        <div class="sidebar-section-heading">
          <h2>Projects</h2>
          <button id="add-project" type="button" class="icon-control" title="Create project" aria-label="Create project">+</button>
        </div>
        <form id="project-form" hidden>
          <label for="project-title">Project name</label>
          <input id="project-title" maxlength="200" placeholder="e.g. Quantum foundations" required />
          <div class="compact-actions">
            <button type="submit">Create</button>
            <button id="cancel-project" type="button" class="secondary">Cancel</button>
          </div>
        </form>
        <label class="archive-filter">
          <input id="show-archived" type="checkbox" />
          Show archived projects and conversations
        </label>
        <nav id="project-tree" aria-label="Projects and conversations"></nav>
        <div class="sidebar-section-heading"><h2>Programmes</h2></div>
        <nav id="programme-tree" aria-label="Approved research programmes"></nav>
        <div class="sidebar-section-heading"><h2>Recent chats</h2></div>
        <nav id="unfiled-chats" aria-label="Unfiled conversations"></nav>
      </aside>

      <main class="assistant-main">
        <header class="conversation-heading">
          <div>
            <p class="eyebrow">RESEARCH ASSISTANT · CANONICAL ACP CONVERSATION</p>
            <h1 id="active-title">Choose a conversation</h1>
            <p id="model-provenance" class="note" aria-live="polite">
              Model metadata appears here after a recorded agent run.
            </p>
            <details id="processing-status" class="processing-status" data-effort="unreported">
              <summary title="Read-only processing and execution provenance">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                  stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 18V5a3 3 0 0 0-6 0 4 4 0 0 0-1.5 7.5A4 4 0 0 0 8 20a4 4 0 0 0 4-2Z"/>
                  <path d="M12 18V5a3 3 0 0 1 6 0 4 4 0 0 1 1.5 7.5A4 4 0 0 1 16 20a4 4 0 0 1-4-2Z"/>
                </svg>
                <span id="processing-status-label">Processing class unavailable</span>
              </summary>
              <p id="processing-provenance" class="note">
                No certified execution-effort class is reported. This indicator does not select a model.
              </p>
            </details>
          </div>
          <div class="heading-actions">
            <button id="toggle-sidebar" type="button" class="secondary" aria-label="Show workspace management" aria-expanded="false" title="Manage projects and conversations">Workspaces</button>
            <button id="toggle-width" type="button" class="secondary icon-control" aria-pressed="false" aria-label="Expand reading area" title="Expand reading area">⤢</button>
            <button id="review-conversation" type="button" class="secondary"
              title="Review conversation and curate reusable research context">Review conversation</button>
            <button id="refresh" type="button" class="secondary" title="Refresh conversation and memories">Refresh</button>
          </div>
        </header>

        <div id="transcript" class="transcript" aria-live="polite">
          <p class="empty">Start a new chat or choose a conversation.</p>
        </div>

        <form id="turn-form" class="composer">
          <label for="message" class="sr-only">Message</label>
          <textarea id="message" rows="3" placeholder="Ask about quantum computing, HPC, or your research…"></textarea>
          <div class="composer-footer">
            <small class="send-shortcut-hint">Ctrl+Enter (⌘+Enter on Mac) sends · Enter inserts a new line</small>
            <button id="send" type="submit">Send</button>
          </div>
        </form>
        <p id="status" role="status" aria-live="polite"></p>

    <details class="panel memory-panel" id="conversation-review" hidden>
      <summary>Conversation review <span class="memory-summary-hint">Suggested context, awaiting your approval</span></summary>
      <div class="memory-content">
        <p id="conversation-review-status" class="note" role="status" aria-live="polite"></p>
        <p id="conversation-review-summary" class="note"></p>
        <div id="conversation-review-candidates" class="memory-list"></div>
        <div id="conversation-review-skill"></div>
        <p class="note">
          This first review extracts explicit statements from the entire canonical chat.
          It is not an AI-generated scientific conclusion. Suggestions are drafts only;
          no memory or skill is created unless you explicitly take action.
        </p>
      </div>
    </details>

    <details class="panel memory-panel" id="profile-details">
      <summary>Assistant preferences <span class="memory-summary-hint">Portable ACP profile</span></summary>
      <p class="note">
        Your research preferences are saved in ACP, not Hermes files.
        They guide response style, but cannot grant tools or provider access.
      </p>
      <form id="assistant-profile-form">
        <label for="assistant-profile-name">Profile name
          <input id="assistant-profile-name" maxlength="100" required value="Research assistant" />
        </label>
        <label for="assistant-profile-notes">Research preferences
          <textarea id="assistant-profile-notes" maxlength="2000" rows="3"
            placeholder="Preferred explanation style, research priorities and notation. No secrets."></textarea>
        </label>
        <p class="note">Model and harness selection is automatic and policy-governed.
          You can inspect recorded processing details above; profile notes never override access or budgets.
        </p>
        <button type="submit" id="assistant-profile-save" disabled>Save ACP profile</button>
        <p id="assistant-profile-status" role="status" aria-live="polite">
          Checking whether the profile service is available…
        </p>
      </form>
    </details>
    <details class="panel memory-panel" id="memory-details">
      <summary>Research memories <span class="memory-summary-hint">Review approved preferences and notes</span></summary>
      <div class="memory-content">
      <div class="conversation-heading">
        <div>
          <p class="eyebrow">M4B · USER-APPROVED MEMORY</p>
          <h2 id="memory-heading">Your research memories</h2>
        </div>
        <button id="refresh-memories" type="button" class="secondary">Reload memories</button>
      </div>
      <p class="note">
        Use <strong>Review conversation</strong> to inspect suggested preferences and
        project notes. Edit a grounded draft, propose it, then approve it explicitly.
        Only approved memories can be used in later sessions.
      </p>
      <form id="memory-form">
        <p id="memory-source" class="note" aria-live="polite">
          Review a conversation and choose a source-backed suggestion first.
        </p>
        <label>
          What should the assistant remember?
          <textarea id="memory-body" rows="3" maxlength="2000"
            placeholder="An accurate, reusable research preference or fact. Do not include secrets."></textarea>
        </label>
        <label>
          Memory category
          <select id="memory-kind">
            <option value="preference">Research preference</option>
            <option value="episodic">Research session note</option>
            <option value="semantic">Research fact or concept</option>
            <option value="project_note">Project note (private)</option>
          </select>
        </label>
        <button id="propose-memory" type="submit" disabled>Propose memory for review</button>
      </form>
      <p id="memory-status" role="status" aria-live="polite"></p>
      <div id="memory-list" class="memory-list">
        <p class="empty">Loading your memory records…</p>
      </div>
      </div>
    </details>

    <details class="panel memory-panel" id="reviewed-resource-details">
      <summary>Reviewed learning resources <span class="memory-summary-hint">
        Versioned Git references, never automatic execution
      </span></summary>
      <p class="note">Only independently reviewed notebooks appear here. Proposals are not
        approved skills. Enabling a reference never runs it or grants a GPU/QPU allocation.</p>
      <button id="reload-reviewed-resources" type="button" class="secondary">
        Refresh reviewed resources
      </button>
      <p id="reviewed-resource-status" role="status" aria-live="polite"></p>
      <div id="reviewed-resource-list"></div>
    </details>
    <p class="note">
      Research memories remain private and require approval. Their use by Hermes
      is separately controlled by ACP deployment settings; saving a memory does not
      guarantee it has been enabled for inference.
    </p>
      </main>
    </div>
  </section>
  <dialog id="workspace-editor" class="workspace-editor" aria-labelledby="workspace-editor-title">
    <form id="workspace-editor-form">
      <h2 id="workspace-editor-title">Edit research workspace</h2>
      <label for="workspace-editor-name">Title
        <input id="workspace-editor-name" required maxlength="200" autocomplete="off" />
      </label>
      <label id="workspace-editor-location-label" for="workspace-editor-location">Project
        <select id="workspace-editor-location"></select>
      </label>
      <label class="workspace-archive-check">
        <input id="workspace-editor-archived" type="checkbox" />
        Archive (retain conversations, memories and research history)
      </label>
      <p id="workspace-editor-error" role="alert" aria-live="polite"></p>
      <div class="compact-actions">
        <button id="workspace-editor-save" type="submit">Save changes</button>
        <button id="workspace-editor-cancel" type="button" class="secondary">Cancel</button>
      </div>
    </form>
  </dialog>
</SiteLayout>

<script>
  import { csrfJsonFetch, requireSession } from '../lib/auth';

  type Project = {
    id: string; title: string; updated_at: string; archived_at?: string | null;
  };
  type Conversation = {
    id: string; project_id?: string | null; title: string;
    updated_at: string; archived_at?: string | null;
  };
  type Workspace = Project | Conversation;
  type WorkspaceKind = 'project' | 'conversation';
  type MemoryItem = {
    id: string;
    status: 'candidate' | 'active' | 'revoked';
    revision: number;
    kind: string;
    body: string | null;
    source_conversation_id: string;
    source_message_id: string;
  };

  type Message = {
    id: string;
    author_kind: string;
    content: unknown;
    sequence: number;
    run_id?: string | null;
  };

  const shell = document.querySelector<HTMLElement>('#assistant-shell');
  const projectTree = document.querySelector<HTMLElement>('#project-tree');
  const unfiledChats = document.querySelector<HTMLElement>('#unfiled-chats');
  const newChat = document.querySelector<HTMLButtonElement>('#new-chat');
  const addProject = document.querySelector<HTMLButtonElement>('#add-project');
  const cancelProject = document.querySelector<HTMLButtonElement>('#cancel-project');
  const projectForm = document.querySelector<HTMLFormElement>('#project-form');
  const projectTitle = document.querySelector<HTMLInputElement>('#project-title');
  const showArchived = document.querySelector<HTMLInputElement>('#show-archived');
  const workspaceEditor = document.querySelector<HTMLDialogElement>('#workspace-editor');
  const workspaceEditorForm = document.querySelector<HTMLFormElement>('#workspace-editor-form');
  const workspaceEditorHeading = document.querySelector<HTMLElement>('#workspace-editor-title');
  const workspaceName = document.querySelector<HTMLInputElement>('#workspace-editor-name');
  const workspaceLocationLabel =
    document.querySelector<HTMLElement>('#workspace-editor-location-label');
  const workspaceLocation = document.querySelector<HTMLSelectElement>('#workspace-editor-location');
  const workspaceArchived = document.querySelector<HTMLInputElement>('#workspace-editor-archived');
  const workspaceEditorError = document.querySelector<HTMLElement>('#workspace-editor-error');
  const workspaceSave = document.querySelector<HTMLButtonElement>('#workspace-editor-save');
  const workspaceCancel = document.querySelector<HTMLButtonElement>('#workspace-editor-cancel');
  const toggleSidebar = document.querySelector<HTMLButtonElement>('#toggle-sidebar');
  const toggleWidth = document.querySelector<HTMLButtonElement>('#toggle-width');
  const memoryDetails = document.querySelector<HTMLDetailsElement>('#memory-details');
  const activeTitle = document.querySelector<HTMLElement>('#active-title');
  const transcript = document.querySelector<HTMLElement>('#transcript');
  const turnForm = document.querySelector<HTMLFormElement>('#turn-form');
  const message = document.querySelector<HTMLTextAreaElement>('#message');
  const send = document.querySelector<HTMLButtonElement>('#send');
  const status = document.querySelector<HTMLParagraphElement>('#status');
  const refresh = document.querySelector<HTMLButtonElement>('#refresh');
  const profileForm = document.querySelector<HTMLFormElement>('#assistant-profile-form');
  const profileName = document.querySelector<HTMLInputElement>('#assistant-profile-name');
  const profileNotes = document.querySelector<HTMLTextAreaElement>('#assistant-profile-notes');
  const profileSave = document.querySelector<HTMLButtonElement>('#assistant-profile-save');
  const profileStatus = document.querySelector<HTMLElement>('#assistant-profile-status');
  let profileRevision = 0;
  // Keep the legacy API field unchanged without presenting an ineffective routing selector.
  let legacyModelRoute: 'general' | 'reasoning' | 'coding' = 'general';

  async function loadPersonalProfile() {
    try {
      const response = await fetch('/api/v1/agent/profile/', {
        credentials: 'same-origin', cache: 'no-store',
      });
      if (!response.ok) throw new Error(
        [404, 503].includes(response.status) ? 'Profile service is not deployed yet.'
          : 'Assistant preferences are unavailable.'
      );
      const data = await response.json();
      const profile = data.profile;
      profileRevision = profile?.revision ?? 0;
      if (profileName) profileName.value = profile?.display_name ?? 'Research assistant';
      if (profileNotes) profileNotes.value = profile?.instructions ?? '';
      legacyModelRoute = ['general', 'reasoning', 'coding'].includes(profile?.model_route)
        ? profile.model_route : 'general';
      if (profileStatus) profileStatus.textContent = profile
        ? 'Preferences loaded from ACP revision ' + profileRevision + '.'
        : 'No saved ACP profile yet. Create one below.';
      if (profileSave) profileSave.disabled = false;
    } catch (error) {
      if (profileSave) profileSave.disabled = true;
      if (profileStatus) profileStatus.textContent =
        error instanceof Error ? error.message : 'Profile service unavailable.';
    }
  }

  profileForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!profileName || !profileNotes || !profileSave) return;
    profileSave.disabled = true;
    if (profileStatus) profileStatus.textContent = 'Saving your preferences…';
    void (async () => {
      try {
        const response = await csrfJsonFetch('/api/v1/agent/profile/', {
          method: 'PUT',
          headers: { 'If-Match': '"' + profileRevision + '"' },
          body: JSON.stringify({
            display_name: profileName.value.trim(),
            instructions: profileNotes.value,
            model_route: legacyModelRoute,
          }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(response.status === 412
          ? 'Preferences changed elsewhere. Reload before saving.'
          : (data.detail ?? 'Profile save failed.'));
        profileRevision = data.revision;
        if (profileStatus) profileStatus.textContent =
          'Saved to ACP. Revision ' + profileRevision + '.';
      } catch (error) {
        if (profileStatus) profileStatus.textContent =
          error instanceof Error ? error.message : 'Profile save failed.';
      } finally {
        profileSave.disabled = false;
      }
    })();
  });

  const memoryForm = document.querySelector<HTMLFormElement>('#memory-form');
  const memoryBody = document.querySelector<HTMLTextAreaElement>('#memory-body');
  const memoryKind = document.querySelector<HTMLSelectElement>('#memory-kind');
  const memorySource = document.querySelector<HTMLElement>('#memory-source');
  const memoryStatus = document.querySelector<HTMLElement>('#memory-status');
  const memoryList = document.querySelector<HTMLElement>('#memory-list');
  const proposeMemory = document.querySelector<HTMLButtonElement>('#propose-memory');
  const refreshMemories = document.querySelector<HTMLButtonElement>('#refresh-memories');

  let sourceConversationId: string | null = null;
  let sourceMessageId: string | null = null;


  let activeProject: string | null = null;
  const reviewedResourceList = document.querySelector<HTMLElement>('#reviewed-resource-list');
  const reviewedResourceStatus = document.querySelector<HTMLElement>('#reviewed-resource-status');
  const reloadReviewedResources = document.querySelector<HTMLButtonElement>(
    '#reload-reviewed-resources',
  );

  type ReviewedResource = {
    id: string; version: string; source_commit: string; manifest_sha256: string;
    resource_path: string; reviewed_by: string;
    required_capabilities: string[]; automatic_code_execution: boolean;
  };
  type ResourceBinding = {
    skill_id: string; version: string; revision: number;
    status: 'enabled' | 'revoked'; currently_reviewed: boolean;
  };

  async function refreshReviewedResources() {
    if (!reviewedResourceList || !reviewedResourceStatus) return;
    reviewedResourceList.replaceChildren();
    reviewedResourceStatus.textContent = 'Checking the reviewed resource catalog…';
    const [catalogReply, bindingReply] = await Promise.all([
      fetch('/api/v1/agent/skills/', { credentials: 'same-origin', cache: 'no-store' }),
      fetch('/api/v1/agent/skills/bindings/', {
        credentials: 'same-origin', cache: 'no-store',
      }),
    ]);
    if (!catalogReply.ok || !bindingReply.ok) {
      reviewedResourceStatus.textContent = 'Reviewed resources are not available until ACP schema v8 and its API are deployed.';
      return;
    }
    const catalog = await catalogReply.json();
    const bindings = await bindingReply.json();
    const resources: ReviewedResource[] = Array.isArray(catalog.items) ? catalog.items : [];
    const owned: ResourceBinding[] = Array.isArray(bindings.items) ? bindings.items : [];
    if (!resources.length) {
      reviewedResourceStatus.textContent =
        'No independently reviewed resources have been published yet. Existing notebook proposals remain available in Git for review.';
      return;
    }
    reviewedResourceStatus.textContent = resources.length + ' reviewed resource(s).';
    for (const item of resources) {
      if (typeof item.id !== 'string' || typeof item.version !== 'string'
          || !/^[0-9a-f]{40}$/.test(item.source_commit)
          || !/^labs\/(?:[A-Za-z0-9_.-]+\/)*[A-Za-z0-9_.-]+\.ipynb$/.test(item.resource_path)
          || item.automatic_code_execution !== false
          || JSON.stringify(item.required_capabilities) !== '["resource:read"]') continue;
      const card = document.createElement('article');
      card.className = 'memory-item';
      const label = document.createElement('strong');
      label.textContent = item.id + ' · v' + item.version;
      const provenance = document.createElement('p');
      provenance.textContent = 'Git ' + item.source_commit.slice(0, 12)
        + ' · independently reviewed by ' + item.reviewed_by;
      const link = document.createElement('a');
      link.textContent = 'View immutable notebook source';
      link.href = 'https://github.com/nyameko/quantum-workflows/blob/'
        + item.source_commit + '/' + item.resource_path;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      const current = owned.find(
        entry => entry.skill_id === item.id && entry.version === item.version,
      );
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'secondary';
      const enabled = current?.status === 'enabled' && current.currently_reviewed;
      button.textContent = enabled ? 'Disable reference' : 'Enable reference';
      button.addEventListener('click', () => {
        button.disabled = true;
        void (async () => {
          try {
            const endpoint = '/api/v1/agent/skills/' + encodeURIComponent(item.id)
              + '/versions/' + encodeURIComponent(item.version) + '/binding/';
            const response = await csrfJsonFetch(endpoint, {
              method: enabled ? 'POST' : 'PUT',
              headers: { 'If-Match': '"' + (current?.revision ?? 0) + '"' },
              body: '{}',
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(response.status === 412
              ? 'Skill binding changed in another session. Refresh before retrying.'
              : result.detail ?? 'Skill binding was denied.');
            reviewedResourceStatus.textContent =
              'Reference state updated in ACP. This did not run a notebook.';
            await refreshReviewedResources();
          } catch (error) {
            reviewedResourceStatus.textContent = error instanceof Error
              ? error.message : 'Reference update failed.';
            button.disabled = false;
          }
        })();
      });
      card.append(label, provenance, link, button);
      reviewedResourceList.append(card);
    }
  }
  reloadReviewedResources?.addEventListener('click', () => void refreshReviewedResources());

  const modelProvenance = document.querySelector<HTMLElement>('#model-provenance');
  const reviewButton = document.querySelector<HTMLButtonElement>('#review-conversation');
  const reviewPanel = document.querySelector<HTMLDetailsElement>('#conversation-review');
  const reviewStatus = document.querySelector<HTMLElement>('#conversation-review-status');
  const reviewSummary = document.querySelector<HTMLElement>('#conversation-review-summary');
  const reviewCandidates = document.querySelector<HTMLElement>('#conversation-review-candidates');
  const reviewSkill = document.querySelector<HTMLElement>('#conversation-review-skill');
  const processingStatus = document.querySelector<HTMLDetailsElement>('#processing-status');
  const processingStatusLabel = document.querySelector<HTMLElement>('#processing-status-label');
  const processingProvenance = document.querySelector<HTMLElement>('#processing-provenance');
  const effortLabels = {
    unreported: 'Processing class unavailable', lookup: 'Quick lookup',
    standard: 'Standard response', extended: 'Extended analysis',
    intensive: 'Intensive synthesis',
  } as const;
  function renderProcessingStatus(run: Record<string, unknown> | null) {
    const routing = run?.routing && typeof run.routing === 'object' && !Array.isArray(run.routing)
      ? run.routing as Record<string, unknown> : null;
    const rawClass = routing?.effective_effort_class;
    const hasPolicy = typeof routing?.policy_revision === 'string'
      && routing.policy_revision.trim().length > 0;
    const observedClass = run?.status === 'succeeded' && hasPolicy
      && typeof rawClass === 'string'
      && Object.prototype.hasOwnProperty.call(effortLabels, rawClass)
      ? rawClass as keyof typeof effortLabels : 'unreported';
    if (processingStatus) processingStatus.dataset.effort = observedClass;
    if (processingStatusLabel) processingStatusLabel.textContent = effortLabels[observedClass];
    if (!processingProvenance) return;
    if (!run) {
      processingProvenance.textContent =
        'No recorded run selected. Classification requires observed, policy-certified execution.';
      return;
    }
    const value = (v: unknown) =>
      typeof v === 'string' && v.trim() ? v.trim().slice(0, 200) : 'not reported';
    const count = (v: unknown) =>
      typeof v === 'number' && Number.isSafeInteger(v) && v >= 0
        ? String(v) : 'not reported';
    const roles = Array.isArray(routing?.agent_roles)
      ? routing.agent_roles.filter((role): role is string => typeof role === 'string').slice(0, 8)
      : [];
    processingProvenance.textContent = [
      'Effort: ' + effortLabels[observedClass],
      'Run status: ' + value(run.status),
      'Policy revision: ' + value(routing?.policy_revision),
      'Logical route: ' + value(routing?.logical_route),
      'Model: ' + value(routing?.model ?? run.model),
      'Harness: ' + value(routing?.harness),
      'Runtime profile: ' + value(run.profile),
      'Agent roles: ' + (roles.length ? roles.join(', ') : 'not reported'),
      'Input tokens: ' + count(routing?.input_tokens),
      'Output tokens: ' + count(routing?.output_tokens),
      'Execution duration (ms): ' + count(routing?.execution_ms),
    ].join('\n');
  }
  let activeConversation: string | null = null;
  // Session-local pointer only; ACP's authenticated run record remains canonical.
  // Never persist bearer tokens or model output in browser storage.
  const runKey = (conversationId: string) => 'qp:personal-run:' + conversationId;
  let pollingGeneration = 0;
  function rememberRun(conversationId: string, runId: string) {
    window.sessionStorage.setItem(runKey(conversationId), runId);
  }
  function clearRememberedRun(conversationId: string, runId: string) {
    if (window.sessionStorage.getItem(runKey(conversationId)) === runId) {
      window.sessionStorage.removeItem(runKey(conversationId));
    }
  }


  function displayContent(value: unknown): string {
    if (typeof value === 'string') return value;

    if (
      value
      && typeof value === 'object'
      && 'text' in value
      && typeof (value as { text?: unknown }).text === 'string'
    ) {
      return (value as { text: string }).text;
    }

    return JSON.stringify(value);
  }

  let availableProjects: Project[] = [];
  let availableConversations: Conversation[] = [];
  const closedFolders = new Set<string>();

  let editingWorkspace: {
    kind: WorkspaceKind; id: string; updatedAt: string;
    title: string; projectId: string | null; archived: boolean;
  } | null = null;

  // The backend owns access control, version checks and all content. UI edits metadata only.
  async function openWorkspaceEditor(
    kind: WorkspaceKind, id: string, focusField: 'name' | 'location' = 'name',
  ) {
    if (workspaceEditorError) workspaceEditorError.textContent = '';
    const collection = kind === 'project' ? 'projects' : 'conversations';
    try {
      const response = await fetch(`/api/v1/agent/${collection}/${id}/`, {
        credentials: 'same-origin', cache: 'no-store',
      });
      const item: Workspace & { detail?: string } = await response.json();
      if (!response.ok) throw new Error(item.detail ?? 'Unable to load workspace.');
      if (!item.updated_at) throw new Error('Workspace version is missing; editing is unavailable.');

      editingWorkspace = {
        kind, id, updatedAt: item.updated_at, title: item.title,
        projectId: 'project_id' in item ? (item.project_id ?? null) : null,
        archived: Boolean(item.archived_at),
      };
      if (workspaceEditorHeading) {
        workspaceEditorHeading.textContent =
          kind === 'project' ? 'Edit personal project' : 'Edit conversation';
      }
      if (workspaceName) workspaceName.value = item.title;
      if (workspaceArchived) workspaceArchived.checked = Boolean(item.archived_at);
      if (workspaceLocation && workspaceLocationLabel) {
        workspaceLocationLabel.hidden = kind === 'project';
        workspaceLocation.replaceChildren();
        if (kind === 'conversation') {
          const unfiled = new Option('Unfiled conversation', '');
          workspaceLocation.add(unfiled);
          for (const project of availableProjects) {
            if (!project.archived_at || project.id === editingWorkspace.projectId) {
              workspaceLocation.add(new Option(project.title, project.id));
            }
          }
          workspaceLocation.value = editingWorkspace.projectId ?? '';
        }
      }
      workspaceEditor?.showModal();
      if (focusField === 'location' && kind === 'conversation') workspaceLocation?.focus();
      else workspaceName?.focus();
    } catch (error) {
      if (status) status.textContent =
        error instanceof Error ? error.message : 'Unable to edit workspace.';
    }
  }

  async function saveWorkspaceChanges(event: SubmitEvent) {
    event.preventDefault();
    const original = editingWorkspace;
    if (!original || !workspaceName || !workspaceArchived || !workspaceSave) return;
    const title = workspaceName.value.trim();
    if (!title || title.length > 200) {
      if (workspaceEditorError) workspaceEditorError.textContent =
        'Enter a title between 1 and 200 characters.';
      return;
    }
    const updates: Record<string, string | boolean | null> = {};
    if (title !== original.title) updates.title = title;
    if (workspaceArchived.checked !== original.archived) {
      updates.archived = workspaceArchived.checked;
    }
    if (original.kind === 'conversation' && workspaceLocation) {
      const target = workspaceLocation.value || null;
      if (target !== original.projectId) updates.project_id = target;
    }
    if (!Object.keys(updates).length) {
      workspaceEditor?.close();
      return;
    }
    workspaceSave.disabled = true;
    if (workspaceEditorError) workspaceEditorError.textContent = '';
    try {
      const collection = original.kind === 'project' ? 'projects' : 'conversations';
      const response = await csrfJsonFetch(`/api/v1/agent/${collection}/${original.id}/`, {
        method: 'PATCH',
        headers: { 'If-Match': '"' + original.updatedAt + '"' },
        body: JSON.stringify(updates),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(response.status === 412
          ? 'This workspace changed elsewhere. Close and reopen to refresh before saving.'
          : (payload.detail ?? 'Unable to save workspace.'));
      }
      workspaceEditor?.close();
      editingWorkspace = null;
      if (status) status.textContent = 'Workspace updated.';
      await loadSidebar();
    } catch (error) {
      if (workspaceEditorError) workspaceEditorError.textContent =
        error instanceof Error ? error.message : 'Unable to save workspace.';
    } finally {
      workspaceSave.disabled = false;
    }
  }

  function isVisibleConversation(chat: Conversation): boolean {
    if (showArchived?.checked) return true;
    if (chat.archived_at) return false;
    return !availableProjects.some(p => p.id === chat.project_id && p.archived_at);
  }

  const workspacePopovers = new Set<HTMLElement>();
  function clearWorkspacePopovers() {
    for (const popup of workspacePopovers) {
      if (popup.matches(':popover-open')) popup.hidePopover();
      popup.remove();
    }
    workspacePopovers.clear();
  }

  async function deleteEmptyWorkspace(kind: WorkspaceKind, item: Workspace) {
    // Read the current owner-scoped record before confirmation, and send its
    // latest ETag to ACP. Neither the browser nor a title match authorizes deletion.
    const collection = kind === 'project' ? 'projects' : 'conversations';
    const endpoint = '/api/v1/agent/' + collection + '/' + item.id + '/';
    try {
      const detail = await fetch(endpoint, {
        credentials: 'same-origin', cache: 'no-store',
      });
      const current = await detail.json().catch(() => ({}));
      if (!detail.ok || !current.updated_at) {
        throw new Error(current.detail ?? 'Workspace no longer available.');
      }
      if (kind === 'conversation' && Array.isArray(current.messages)
          && current.messages.length > 0) {
        throw new Error('This chat contains messages. Archive it instead; permanent deletion is only available for empty chats.');
      }
      const label = kind === 'project' ? 'project' : 'conversation';
      if (!window.confirm(
        'Permanently delete this EMPTY ' + label + '?\n\n'
        + current.title + '\nID: ' + item.id
        + '\n\nThis cannot be undone. Chats with messages or runs and projects'
        + ' with conversations cannot be deleted.'
      )) return;
      const reply = await csrfJsonFetch(endpoint, {
        method: 'DELETE',
        headers: { 'If-Match': '"' + current.updated_at + '"' },
      });
      if (!reply.ok) {
        const error = await reply.json().catch(() => ({}));
        throw new Error(reply.status === 412
          ? 'Workspace changed. Refresh and confirm again before deleting.'
          : (error.detail ?? 'Deletion was denied. Archive instead.'));
      }
      if (kind === 'conversation') {
        window.sessionStorage.removeItem(runKey(item.id));
        if (activeConversation === item.id) {
          activeConversation = null;
          activeProject = null;
          window.sessionStorage.removeItem('qp:last-conversation-id');
        }
      } else {
        closedFolders.delete(item.id);
        if (activeProject === item.id && !activeConversation) activeProject = null;
      }
      await loadSidebar();
      if (status) status.textContent = 'Empty ' + label + ' permanently deleted.';
    } catch (error) {
      if (status) status.textContent =
        error instanceof Error ? error.message : 'Deletion failed.';
    }
  }

  function workspaceMenu(kind: WorkspaceKind, item: Workspace) {
    const trigger = document.createElement('button');
    trigger.type = 'button';
    trigger.className = 'workspace-menu';
    trigger.textContent = '⋯';
    trigger.setAttribute('aria-label', 'Actions for ' + item.title);
    trigger.setAttribute('aria-haspopup', 'menu');
    trigger.setAttribute('aria-expanded', 'false');

    const actions = document.createElement('div');
    actions.className = 'workspace-menu-actions';
    actions.setAttribute('role', 'menu');
    actions.setAttribute('popover', 'auto');
    document.body.append(actions);
    workspacePopovers.add(actions);
    actions.addEventListener('toggle', () => trigger.setAttribute(
      'aria-expanded', String(actions.matches(':popover-open'))));
    trigger.addEventListener('click', () => {
      if (actions.matches(':popover-open')) { actions.hidePopover(); return; }
      actions.showPopover();
      const rect = trigger.getBoundingClientRect();
      const width = Math.min(208, window.innerWidth - 16);
      const height = actions.getBoundingClientRect().height;
      Object.assign(actions.style, {
        position: 'fixed', inset: 'auto', margin: '0',
        left: Math.max(8, Math.min(rect.right - width, window.innerWidth - width - 8)) + 'px',
        top: (window.innerHeight - rect.bottom >= height + 8
          ? rect.bottom + 5 : Math.max(8, rect.top - height - 5)) + 'px',
        right: 'auto', bottom: 'auto', width: width + 'px',
      });
      actions.querySelector<HTMLButtonElement>('button:not(:disabled)')?.focus();
    });

    const option = (
      label: string, fn?: () => void, disabledReason?: string, danger = false,
    ) => {
      const button = document.createElement('button');
      button.type = 'button'; button.textContent = label;
      if (danger) button.classList.add('workspace-danger');
      if (disabledReason) {
        button.disabled = true;
        button.title = disabledReason;
      }
      if (fn) button.addEventListener('click', () => { actions.hidePopover(); fn(); });
      actions.append(button);
    };
    const divider = () => {
      const hr = document.createElement('hr');
      hr.className = 'workspace-menu-divider';
      hr.setAttribute('role', 'separator');
      actions.append(hr);
    };
    const mutate = (changes: Record<string, unknown>) => {
      void (async () => {
        try {
          const collection = kind === 'project' ? 'projects' : 'conversations';
          const endpoint = '/api/v1/agent/' + collection + '/' + item.id + '/';
          const detail = await fetch(endpoint, {
            credentials: 'same-origin', cache: 'no-store',
          });
          const current = await detail.json().catch(() => ({}));
          if (!detail.ok || !current.updated_at) {
            throw new Error(current.detail ?? 'Workspace no longer available.');
          }
          const reply = await csrfJsonFetch(endpoint, {
            method: 'PATCH',
            headers: { 'If-Match': '"' + current.updated_at + '"' },
            body: JSON.stringify(changes),
          });
          const result = await reply.json().catch(() => ({}));
          if (!reply.ok) throw new Error(reply.status === 412
            ? 'Workspace changed. Refresh before editing.'
            : (result.detail ?? 'Could not update workspace.'));
          if (status) status.textContent = 'Workspace updated in ACP.';
          await loadSidebar();
        } catch (error) {
          if (status) status.textContent = error instanceof Error
            ? error.message : 'Workspace update failed.';
        }
      })();
    };
    const submenu = (label: string, mode: 'projects' | 'programmes') => {
      const toggle = document.createElement('button');
      toggle.type = 'button'; toggle.className = 'workspace-submenu-trigger';
      toggle.textContent = label; toggle.setAttribute('aria-expanded', 'false');
      const panel = document.createElement('div');
      panel.className = 'workspace-submenu'; panel.hidden = true;
      toggle.addEventListener('click', () => {
        panel.hidden = !panel.hidden;
        toggle.setAttribute('aria-expanded', String(!panel.hidden));
        if (panel.hidden || panel.childElementCount) return;
        if (mode === 'projects') {
          const currentId = 'project_id' in item ? item.project_id : null;
          for (const project of availableProjects.filter(p => !p.archived_at)) {
            const choice = document.createElement('button');
            choice.type = 'button';
            choice.textContent = project.title + (project.id === currentId ? ' ✓' : '');
            choice.disabled = project.id === currentId;
            choice.addEventListener('click', () => {
              actions.hidePopover();
              mutate({ project_id: project.id });
            });
            panel.append(choice);
          }
          if (!panel.childElementCount) {
            const msg = document.createElement('span');
            msg.className = 'workspace-submenu-note';
            msg.textContent = 'No active projects yet.';
            panel.append(msg);
          }
        } else {
          const msg = document.createElement('span');
          msg.className = 'workspace-submenu-note';
          msg.textContent = 'Checking approved programmes…';
          panel.append(msg);
          void (async () => {
            try {
              const response = await fetch('/api/v1/me/', {
                credentials: 'same-origin', cache: 'no-store',
              });
              if (!response.ok) throw new Error('Programme membership unavailable.');
              const me = await response.json();
              const memberships = (me.memberships ?? []).filter(
                (m: {status:string;programme?:{name?:string}}) =>
                  m.status === 'approved' && Boolean(m.programme?.name),
              );
              msg.textContent = memberships.length
                ? 'Pending PI-approval sharing is not enabled yet.'
                : 'No approved programmes available.';
              for (const membership of memberships) {
                const choice = document.createElement('button');
                choice.type = 'button'; choice.disabled = true;
                choice.textContent = membership.programme.name;
                choice.title = 'Cannot share until PI request/approval workflow is implemented';
                panel.append(choice);
              }
            } catch (error) {
              msg.textContent = error instanceof Error ? error.message : 'Programmes unavailable.';
            }
          })();
        }
      });
      actions.append(toggle, panel);
    };

    if (kind === 'conversation') {
      option('Rename', () => { void openWorkspaceEditor(kind, item.id, 'name'); });
      option('Pin', undefined, 'Requires canonical ACP pin support');
      option(item.archived_at ? 'Restore' : 'Archive',
        () => mutate({ archived: !item.archived_at }));
      divider();
      submenu('Share to Programme', 'programmes');
      divider();
      submenu('Move to Project', 'projects');
      option('Remove from Project',
        ('project_id' in item && item.project_id) ? () => mutate({ project_id: null }) : undefined,
        ('project_id' in item && item.project_id) ? undefined : 'Conversation is not in a project');
      divider();
      option('Delete empty chat permanently',
        () => { void deleteEmptyWorkspace(kind, item); }, undefined, true);
    } else {
      submenu('Share to Programme', 'programmes');
      divider();
      option('Rename Project', () => { void openWorkspaceEditor(kind, item.id); });
      option('Project Settings', () => { void openWorkspaceEditor(kind, item.id); });
      option('Pin Project', undefined, 'Requires canonical ACP pin support');
      option(item.archived_at ? 'Restore Project' : 'Remove Project from sidebar',
        () => mutate({ archived: !item.archived_at }));
      divider();
      option('Delete empty project',
        () => { void deleteEmptyWorkspace(kind, item); }, undefined, true);
      if (!item.archived_at) option('New chat in Project', () => beginDraft(item.id));
    }
    return trigger;
  }

  function labelForDuplicate(
    item: {id: string;title: string},
    all: Array<{id:string;title:string}>,
  ) {
    const count = all.filter(candidate =>
      candidate.title.trim().toLocaleLowerCase() ===
      item.title.trim().toLocaleLowerCase()
    ).length;
    return count > 1 ? item.title + ' · #' + item.id.slice(0, 6) : item.title;
  }

  function appendChat(parent: HTMLElement, chat: Conversation) {
    const row = document.createElement('div');
    row.className = 'chat-row';
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'sidebar-chat' + (chat.id === activeConversation ? ' selected' : '');
    button.textContent = (chat.archived_at ? 'Archived · ' : '')
      + labelForDuplicate(chat, availableConversations);
    button.title = chat.title || 'New chat';
    if (chat.id === activeConversation) button.setAttribute('aria-current', 'page');
    button.addEventListener('click', () => void selectConversation(chat));
    row.append(button, workspaceMenu('conversation', chat));
    parent.append(row);
  }

  function renderSidebar() {
    if (!projectTree || !unfiledChats) return;
    clearWorkspacePopovers();
    projectTree.replaceChildren();
    unfiledChats.replaceChildren();

    for (const project of availableProjects.filter(p => showArchived?.checked || !p.archived_at)) {
      const group = document.createElement('div');
      group.className = 'project-group';
      const header = document.createElement('div');
      header.className = 'project-header';
      const fold = document.createElement('button');
      fold.type = 'button';
      fold.className = 'folder-name';
      const open = !closedFolders.has(project.id);
      fold.textContent = (open ? '▾ ' : '▸ ')
        + (project.archived_at ? 'Archived · ' : '')
        + labelForDuplicate(project, availableProjects);
      fold.setAttribute('aria-expanded', String(open));
      fold.title = project.title;
      const children = document.createElement('div');
      children.className = 'project-children';
      children.hidden = !open;
      fold.addEventListener('click', () => {
        if (closedFolders.has(project.id)) closedFolders.delete(project.id);
        else closedFolders.add(project.id);
        renderSidebar();
      });
      header.append(fold, workspaceMenu('project', project));
      availableConversations.filter(c => c.project_id === project.id && isVisibleConversation(c))
        .forEach(chat => appendChat(children, chat));
      group.append(header, children);
      projectTree.append(group);
    }
    const other = availableConversations.filter(c => isVisibleConversation(c) && !c.project_id).slice(0, 15);
    other.forEach(chat => appendChat(unfiledChats, chat));
    if (!other.length) {
      const empty = document.createElement('small');
      empty.className = 'small-note';
      empty.textContent = 'No recent chats';
      unfiledChats.append(empty);
    }
  }

  async function loadSidebar(preferredId?: string) {
    const [projectResponse, conversationResponse] = await Promise.all([
      fetch('/api/v1/agent/projects/', { credentials: 'same-origin', cache: 'no-store' }),
      fetch('/api/v1/agent/conversations/', { credentials: 'same-origin', cache: 'no-store' }),
    ]);
    if (!projectResponse.ok || !conversationResponse.ok) {
      if (status) status.textContent = 'Unable to load projects or conversations.';
      return;
    }
    const projectData = await projectResponse.json();
    const conversationData = await conversationResponse.json();
    availableProjects = projectData.items ?? [];
    availableConversations = conversationData.items ?? [];
    const requested = preferredId ?? activeConversation
      ?? window.sessionStorage.getItem('qp:last-conversation-id');
    const selected = availableConversations.find(c => c.id === requested && isVisibleConversation(c))
      ?? availableConversations.find(c => isVisibleConversation(c));
    activeConversation = selected?.id ?? null;
    activeProject = selected?.project_id ?? null;
    if (activeConversation) window.sessionStorage.setItem('qp:last-conversation-id', activeConversation);
    else window.sessionStorage.removeItem('qp:last-conversation-id');
    renderSidebar();
    await loadConversation();
  }

  async function selectConversation(chat: Conversation) {
    pollingGeneration += 1;
    activeConversation = chat.id;
    activeProject = chat.project_id ?? null;
    window.sessionStorage.setItem('qp:last-conversation-id', chat.id);
    renderSidebar();
    await loadConversation();
  }

  function beginDraft(projectId: string | null = null) {
    // No UUID, chat entry or ACP database row until the first Send.
    pollingGeneration += 1;
    activeConversation = null;
    activeProject = projectId;
    window.sessionStorage.removeItem('qp:last-conversation-id');
    if (activeTitle) activeTitle.textContent = 'New research conversation';
    if (modelProvenance) modelProvenance.textContent =
      'No model run yet — this draft has not been saved.';
    if (status) status.textContent =
      'New unsaved conversation. Send a message to save it.';
    renderMessages([]);
    renderSidebar();
    if (message) message.value = '';
    message?.focus();
  }

  function suggestConversationTitle(firstMessage: string): string {
    return firstMessage.replace(/\s+/g, ' ').trim().slice(0, 80) || 'New chat';
  }

  async function createConversation(firstMessage: string): Promise<boolean> {
    if (newChat) newChat.disabled = true;
    try {
      const payload = {
        title: suggestConversationTitle(firstMessage),
        ...(activeProject ? { project_id: activeProject } : {}),
      };
      let response = await csrfJsonFetch('/api/v1/agent/conversations/', {
        method: 'POST', body: JSON.stringify(payload),
      });
      // The same opening question can be sent twice. Preserve uniqueness
      // without rejecting an otherwise valid first message.
      if (response.status === 409) {
        response = await csrfJsonFetch('/api/v1/agent/conversations/', {
          method: 'POST',
          body: JSON.stringify({ ...payload, title: 'New chat' }),
        });
      }
      const body = await response.json().catch(() => ({}));
      if (!response.ok || !body.id) {
        throw new Error(body.detail ?? 'Unable to create conversation.');
      }
      activeConversation = body.id;
      activeProject = body.project_id ?? null;
      window.sessionStorage.setItem('qp:last-conversation-id', body.id);
      await loadSidebar(body.id);
      return true;
    } catch (error) {
      if (status) status.textContent =
        error instanceof Error ? error.message : 'Unable to create conversation.';
      return false;
    } finally {
      if (newChat) newChat.disabled = false;
    }
  }

  function renderMessages(items: Message[]) {
    if (!transcript) return;

    transcript.replaceChildren();

    if (!items.length) {
      const empty = document.createElement('p');
      empty.className = 'empty';
      empty.textContent = 'No messages yet.';
      transcript.append(empty);
      return;
    }

    for (const item of items) {
      const article = document.createElement('article');
      article.className = 'message ' + item.author_kind;

      const role = document.createElement('strong');
      role.textContent = item.author_kind === 'assistant' ? 'Agent' : 'You';

      const body = document.createElement('p');
      body.textContent = displayContent(item.content);

      article.append(role, body);
      transcript.append(article);
    }

    transcript.scrollTop = transcript.scrollHeight;
  }

  reviewButton?.addEventListener('click', () => void reviewConversation());

  async function reviewConversation() {
    const conversationId = activeConversation;
    if (!conversationId || !reviewPanel || !reviewSummary || !reviewCandidates
        || !reviewSkill || !reviewStatus) {
      if (status) status.textContent = 'Send or choose a saved conversation first.';
      return;
    }
    reviewPanel.hidden = false;
    reviewPanel.open = true;
    reviewCandidates.replaceChildren();
    reviewSkill.replaceChildren();
    reviewSummary.textContent = '';
    reviewStatus.textContent = 'Reviewing canonical ACP conversation…';
    if (reviewButton) reviewButton.disabled = true;
    try {
      const response = await fetch(
        '/api/v1/agent/conversations/' + conversationId + '/review/',
        { credentials: 'same-origin', cache: 'no-store' },
      );
      const data = await response.json().catch(() => ({}));
      if (activeConversation !== conversationId) return;
      if (!response.ok) throw new Error(data.detail ?? 'Conversation review unavailable.');
      if (data.review_type !== 'extractive_preview'
          || !Array.isArray(data.candidates) || !Array.isArray(data.topics)) {
        throw new Error('Unexpected review format.');
      }
      reviewSummary.textContent = 'Reviewed ' + Number(data.user_turns || 0)
        + ' researcher turns and ' + Number(data.assistant_turns || 0)
        + ' assistant responses. Extracted topics (not a model-generated summary):';
      const topics = document.createElement('ul');
      for (const topic of data.topics) {
        const li = document.createElement('li');
        li.textContent = 'Message ' + topic.sequence + ': ' + String(topic.excerpt);
        topics.append(li);
      }
      if (!topics.childElementCount) {
        const li = document.createElement('li');
        li.textContent = 'No substantive researcher requests found.';
        topics.append(li);
      }
      reviewCandidates.append(topics);
      const heading = document.createElement('h3');
      heading.textContent = 'Suggested reusable context (' + data.candidates.length + ')';
      reviewCandidates.append(heading);
      if (!data.candidates.length) {
        const empty = document.createElement('p');
        empty.textContent = 'No clear reusable preference found. Nothing was saved.';
        reviewCandidates.append(empty);
      }
      for (const candidate of data.candidates as Array<{
        body: string; kind: string; source_message_id: string;
        source_conversation_id: string; source_sequence: number;
      }>) {
        const card = document.createElement('article');
        card.className = 'memory-item';
        const body = document.createElement('p');
        body.textContent = candidate.body;
        const provenance = document.createElement('small');
        provenance.textContent = 'Source: your message #' + candidate.source_sequence
          + ' · ' + candidate.kind + ' · unapproved suggestion';
        const choose = document.createElement('button');
        choose.type = 'button';
        choose.className = 'secondary';
        choose.textContent = 'Edit as memory proposal';
        choose.addEventListener('click', () => {
          if (activeConversation !== conversationId) return;
          sourceConversationId = candidate.source_conversation_id;
          sourceMessageId = candidate.source_message_id;
          if (memoryBody) memoryBody.value = candidate.body.slice(0, 2000);
          if (memoryKind) memoryKind.value =
            ['preference', 'project_note', 'semantic', 'episodic'].includes(candidate.kind)
              ? candidate.kind : 'project_note';
          if (memorySource) memorySource.textContent =
            'Proposal grounded in your message #' + candidate.source_sequence + '.';
          if (proposeMemory) proposeMemory.disabled = false;
          if (memoryDetails) {
            memoryDetails.open = true;
            memoryDetails.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          }
          memoryBody?.focus();
        });
        card.append(body, provenance, choose);
        reviewCandidates.append(card);
      }
      const skill = data.skill_draft;
      if (skill && typeof skill.markdown === 'string') {
        const title = document.createElement('h3');
        title.textContent = 'Proposed reusable workflow / skill (not installed)';
        const draft = document.createElement('textarea');
        draft.value = skill.markdown;
        draft.readOnly = true;
        draft.rows = 7;
        draft.setAttribute('aria-label', 'Draft skill for Git review');
        const copy = document.createElement('button');
        copy.type = 'button'; copy.className = 'secondary';
        copy.textContent = 'Copy draft for review';
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(draft.value);
            if (reviewStatus) reviewStatus.textContent =
              'Draft copied; it is not an active or approved skill.';
          } catch {
            if (reviewStatus) reviewStatus.textContent =
              'Clipboard unavailable; select and copy the draft manually.';
          }
        });
        reviewSkill.append(title, draft, copy);
      }
      reviewStatus.textContent = 'Preview ready. No memories or skills saved.';
    } catch (error) {
      if (reviewStatus) reviewStatus.textContent = error instanceof Error
        ? error.message : 'Review failed.';
    } finally {
      if (reviewButton) reviewButton.disabled = false;
    }
  }

  async function loadConversation() {
    if (reviewPanel) {
      reviewPanel.hidden = true;
      reviewPanel.open = false;
    }
    renderProcessingStatus(null);
    sourceConversationId = null;
    sourceMessageId = null;
    if (proposeMemory) proposeMemory.disabled = true;
    if (memorySource) {
      memorySource.textContent = 'Review a conversation and choose a source-backed suggestion.';
    }
    if (!activeConversation) {
      if (activeTitle) activeTitle.textContent = 'New research conversation';
      if (send) send.disabled = false;
      renderMessages([]);
      return;
    }

    const path = '/api/v1/agent/conversations/' + activeConversation + '/';
    const response = await fetch(path, {
      credentials: 'same-origin',
      cache: 'no-store',
    });
    const payload = await response.json().catch(() => ({}));

    if (!response.ok) {
      if (response.status === 404) {
        // A stale browser pointer should not make the rest of Guide unusable.
        activeConversation = null;
        activeProject = null;
        window.sessionStorage.removeItem('qp:last-conversation-id');
        if (activeTitle) activeTitle.textContent = 'Choose a conversation';
        renderMessages([]);
        if (status) status.textContent =
          'That conversation is no longer available. Select another chat or create one.';
        return;
      }
      if (status) status.textContent = payload.detail ?? 'Unable to load conversation.';
      return;
    }

    if (activeTitle) activeTitle.textContent =
      (payload.archived_at ? 'Archived · ' : '') + (payload.title ?? 'Conversation');
    if (send) send.disabled = Boolean(payload.archived_at);
    if (payload.archived_at && status) {
      status.textContent = 'This conversation is archived and read-only. Use ⋯ to restore it.';
    }
    const messages: Message[] = payload.messages ?? [];
    renderMessages(messages);
    if (modelProvenance) {
      modelProvenance.textContent = 'Model metadata not recorded for this conversation.';
      const lastRun = [...messages].reverse().find(item =>
        item.author_kind === 'assistant' && item.run_id,
      )?.run_id;
      if (lastRun) {
        const selectedConversation = activeConversation;
        try {
          const response = await fetch(
            '/api/v1/agent/runs/' + encodeURIComponent(lastRun) + '/', {
              credentials: 'same-origin', cache: 'no-store',
            },
          );
          const detail = await response.json().catch(() => ({}));
          if (activeConversation === selectedConversation && response.ok
            && detail.conversation_id === selectedConversation
            && typeof detail.model === 'string' && detail.model) {
            modelProvenance.textContent = 'Last response model: ' + detail.model
              + ' · Runtime profile: ' + (detail.profile ?? 'not reported');
            renderProcessingStatus(detail);
          }
        } catch {
          // Inference provenance is supplementary; transcript remains usable.
        }
      }
    }
    await refreshRunStatus(activeConversation);
  }

  async function refreshRunStatus(conversationId: string) {
    const runId = window.sessionStorage.getItem(runKey(conversationId));
    if (!runId || conversationId !== activeConversation) return;
    const response = await fetch('/api/v1/agent/runs/' + encodeURIComponent(runId) + '/', {
      credentials: 'same-origin',
      cache: 'no-store',
    });
    const run = await response.json().catch(() => ({}));
    if (conversationId !== activeConversation) return;
    if (!response.ok) {
      // A remembered run can expire or disappear independently of its durable
      // conversation. Clear only the stale run pointer, never the conversation.
      if (response.status === 404) {
        clearRememberedRun(conversationId, runId);
        if (status) status.textContent = 'Previous run status expired; your conversation is still available.';
        return;
      }
      if (status) status.textContent = run.detail ?? 'Unable to read agent status.';
      if (response.status === 403) clearRememberedRun(conversationId, runId);
      return;
    }
    if (run.conversation_id !== conversationId) {
      clearRememberedRun(conversationId, runId);
      if (status) status.textContent = 'Run does not belong to this conversation.';
      return;
    }
    renderProcessingStatus(run);
    if (run.status === 'succeeded') {
      clearRememberedRun(conversationId, runId);
      if (status) status.textContent = 'Response persisted.';
      return;
    }
    if (run.status === 'failed') {
      clearRememberedRun(conversationId, runId);
      if (status) status.textContent =
        'Agent run failed: ' + (run.failure_code ?? 'unknown error');
      return;
    }
    if (status) status.textContent = run.status === 'queued'
      ? 'Agent run queued…'
      : 'Agent is responding…';
  }

  async function pollRun(runId: string, conversationId: string) {
    const generation = ++pollingGeneration;
    for (let attempt = 0; attempt < 60; attempt += 1) {
      if (generation !== pollingGeneration || activeConversation !== conversationId) return;
      await refreshRunStatus(conversationId);
      if (window.sessionStorage.getItem(runKey(conversationId)) !== runId) return;
      await new Promise((resolve) => window.setTimeout(resolve, 1000));
    }
    if (status && conversationId === activeConversation) {
      status.textContent = 'Agent run is still active. Use Refresh to check its status.';
    }
  }

  async function loadMemories() {
    if (!memoryList) return;
    const response = await fetch('/api/v1/agent/memories/', {
      credentials: 'same-origin',
      cache: 'no-store',
    });
    const payload = await response.json().catch(() => ({}));
    memoryList.replaceChildren();

    if (!response.ok) {
      if (memoryStatus) {
        memoryStatus.textContent = [404, 503].includes(response.status)
          ? 'Memory controls are not available until the ACP memory service is activated.'
          : (payload.detail ?? 'Unable to load memories.');
      }
      return;
    }

    const items: MemoryItem[] = payload.items ?? [];
    if (memoryStatus) {
      memoryStatus.textContent = 'Memory list refreshed · ' + items.length + ' record(s).';
    }
    if (!items.length) {
      const empty = document.createElement('p');
      empty.className = 'empty';
      empty.textContent = 'No saved memories. Choose a message above to get started.';
      memoryList.append(empty);
      return;
    }

    for (const item of items) {
      const article = document.createElement('article');
      article.className = 'memory-item';
      const heading = document.createElement('strong');
      heading.textContent = item.kind.replaceAll('_', ' ') + ' · ' + item.status;
      const detail = document.createElement('p');
      detail.textContent = item.body ?? 'Revoked — no longer available for retrieval.';
      const source = document.createElement('small');
      source.textContent = 'Source conversation ' + item.source_conversation_id
        + ', message ' + item.source_message_id + ' · revision ' + item.revision;
      article.append(heading, detail, source);

      if (item.status !== 'revoked') {
        const actions = document.createElement('div');
        actions.className = 'memory-actions';
        if (item.status === 'candidate') {
          const approve = document.createElement('button');
          approve.type = 'button';
          approve.textContent = 'Approve memory';
          approve.addEventListener('click', () => void changeMemory(item, 'approve'));
          actions.append(approve);
        }
        if (item.status === 'active' && item.body) {
          const edit = document.createElement('button');
          edit.type = 'button';
          edit.className = 'secondary';
          edit.textContent = 'Correct memory';
          edit.addEventListener('click', () => {
            if (article.querySelector('.memory-correction')) return;
            const form = document.createElement('form');
            form.className = 'memory-correction';
            const label = document.createElement('label');
            label.textContent = 'Corrected memory (requires your approval)';
            const field = document.createElement('textarea');
            field.rows = 3;
            field.maxLength = 2000;
            field.value = item.body ?? '';
            label.append(field);
            const formActions = document.createElement('div');
            formActions.className = 'memory-actions';
            const save = document.createElement('button');
            save.type = 'submit';
            save.textContent = 'Save correction';
            const cancel = document.createElement('button');
            cancel.type = 'button';
            cancel.className = 'secondary';
            cancel.textContent = 'Cancel';
            cancel.addEventListener('click', () => form.remove());
            const errorMessage = document.createElement('p');
            errorMessage.setAttribute('role', 'status');
            formActions.append(save, cancel);
            form.append(label, formActions, errorMessage);
            form.addEventListener('submit', async (event) => {
              event.preventDefault();
              const corrected = field.value.trim();
              if (!corrected || corrected.length > 2000) {
                errorMessage.textContent = 'Enter 1–2000 characters.';
                return;
              }
              save.disabled = true;
              cancel.disabled = true;
              try {
                const response = await csrfJsonFetch(
                  '/api/v1/agent/memories/' + item.id + '/',
                  {
                    method: 'PATCH',
                    headers: { 'If-Match': '"' + item.revision + '"' },
                    body: JSON.stringify({ body: corrected }),
                  },
                );
                const result = await response.json().catch(() => ({}));
                if (!response.ok) {
                  throw new Error(result.detail ?? 'Memory correction failed.');
                }
                await loadMemories();
                if (memoryStatus) {
                  memoryStatus.textContent = 'Memory corrected; previous revision retained for audit.';
                }
              } catch (error) {
                errorMessage.textContent = error instanceof Error
                  ? error.message : 'Unable to correct memory.';
              } finally {
                save.disabled = false;
                cancel.disabled = false;
              }
            });
            article.append(form);
            field.focus();
          });
          actions.append(edit);
        }
        const revoke = document.createElement('button');
        revoke.type = 'button';
        revoke.className = 'secondary';
        revoke.textContent = 'Revoke';
        revoke.addEventListener('click', () => void changeMemory(item, 'revoke'));
        actions.append(revoke);
        article.append(actions);
      }
      memoryList.append(article);
    }
  }

  async function changeMemory(item: MemoryItem, action: 'approve' | 'revoke') {
    if (!memoryList) return;
    const buttons = memoryList.querySelectorAll<HTMLButtonElement>('button');
    buttons.forEach((button) => { button.disabled = true; });
    if (memoryStatus) memoryStatus.textContent = 'Updating memory…';
    try {
      const response = await csrfJsonFetch(
        '/api/v1/agent/memories/' + item.id + '/' + action + '/',
        {
          method: 'POST',
          headers: { 'If-Match': '"' + item.revision + '"' },
          body: JSON.stringify({}),
        },
      );
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(payload.detail ?? 'Unable to update memory.');
      }
      await loadMemories();
      if (memoryStatus) {
        memoryStatus.textContent = action === 'approve'
          ? 'Memory approved for future retrieval.'
          : 'Memory revoked; it will not be retrieved again.';
      }
    } catch (error) {
      await loadMemories();
      if (memoryStatus) {
        memoryStatus.textContent = error instanceof Error ? error.message : 'Memory update failed.';
      }
    } finally {
      buttons.forEach((button) => { button.disabled = false; });
    }
  }

  memoryForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const body = memoryBody?.value.trim();
    if (!sourceConversationId || !sourceMessageId || !body || !proposeMemory) {
      if (memoryStatus) memoryStatus.textContent = 'Choose a source message and enter a memory.';
      return;
    }
    proposeMemory.disabled = true;
    if (memoryStatus) memoryStatus.textContent = 'Saving proposal…';
    try {
      const response = await csrfJsonFetch('/api/v1/agent/memories/', {
        method: 'POST',
        headers: { 'Idempotency-Key': crypto.randomUUID() },
        body: JSON.stringify({
          source_conversation_id: sourceConversationId,
          source_message_id: sourceMessageId,
          kind: memoryKind?.value ?? 'preference',
          body,
        }),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.detail ?? 'Memory proposal failed.');
      await loadMemories();
      if (memoryStatus) {
        memoryStatus.textContent = 'Proposal saved. Review it below and select Approve memory.';
      }
    } catch (error) {
      if (memoryStatus) {
        memoryStatus.textContent = error instanceof Error ? error.message : 'Memory proposal failed.';
      }
    } finally {
      proposeMemory.disabled = false;
    }
  });

  refreshMemories?.addEventListener('click', () => void loadMemories());

  addProject?.addEventListener('click', () => {
    if (projectForm) projectForm.hidden = false;
    projectTitle?.focus();
  });
  cancelProject?.addEventListener('click', () => {
    if (projectForm) projectForm.hidden = true;
  });
  workspaceEditorForm?.addEventListener('submit', (event) => void saveWorkspaceChanges(event));
  workspaceCancel?.addEventListener('click', () => workspaceEditor?.close());
  workspaceEditor?.addEventListener('close', () => { editingWorkspace = null; });
  showArchived?.addEventListener('change', () => void loadSidebar());

  projectForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const title = projectTitle?.value.trim();
    if (!title) return;
    const response = await csrfJsonFetch('/api/v1/agent/projects/', {
      method: 'POST', body: JSON.stringify({ title }),
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) {
      if (status) status.textContent = payload.detail ?? 'Unable to create project.';
      return;
    }
    if (projectForm) projectForm.hidden = true;
    if (projectTitle) projectTitle.value = '';
    await loadSidebar();
    // Creating a project does not create an unwanted empty conversation.
  });
  newChat?.addEventListener('click', () => beginDraft());
  toggleSidebar?.addEventListener('click', () => {
    const collapsed = shell?.classList.toggle('nav-collapsed') ?? false;
    toggleSidebar.setAttribute('aria-expanded', String(!collapsed));
    toggleSidebar.setAttribute('aria-label',
      collapsed ? 'Show workspace management' : 'Hide workspace management');
  });
  toggleWidth?.addEventListener('click', () => {
    const wide = shell?.classList.toggle('reading-wide') ?? false;
    toggleWidth.setAttribute('aria-pressed', String(wide));
    toggleWidth.title = wide ? 'Restore reading width' : 'Expand reading area';
  });
  // Preserve multiline code and research prompts: Enter inserts a newline,
  // while Ctrl+Enter (or Cmd+Enter on macOS) submits the existing form.
  message?.addEventListener('keydown', (event) => {
    if (
      event.key !== 'Enter'
      || !(event.ctrlKey || event.metaKey)
      || event.shiftKey
      || event.altKey
      || event.repeat
      || event.isComposing
    ) return;

    event.preventDefault();
    if (!message.value.trim() || send?.disabled) return;
    turnForm?.requestSubmit();
  });

  turnForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const content = message?.value.trim();

    if (!content || !send || send.disabled) return;
    // Lock submissions before creating a canonical conversation, so a double
    // click cannot produce two empty "New chat" rows.
    send.disabled = true;
    if (!activeConversation && !await createConversation(content)) {
      send.disabled = false;
      return;
    }
    const submittedConversation = activeConversation;
    if (!submittedConversation) {
      send.disabled = false;
      return;
    }

    if (status) status.textContent = 'Agent run queued…';
    renderProcessingStatus(null);

    const idempotencyKey = crypto.randomUUID();
    const clientMessageId = crypto.randomUUID();

    try {
      const path = '/api/v1/agent/conversations/'
        + submittedConversation
        + '/turns/';
      const response = await csrfJsonFetch(path, {
        method: 'POST',
        headers: { 'Idempotency-Key': idempotencyKey },
        body: JSON.stringify({
          content: { text: content },
          source_channel: 'web',
          client_message_id: clientMessageId,
        }),
      });
      const payload = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(payload.detail ?? 'Unable to queue agent turn.');
      }

      if (message) message.value = '';
      await loadConversation();

      rememberRun(submittedConversation, payload.run_id);
      if (status) status.textContent = 'Agent is responding…';
      await pollRun(payload.run_id, submittedConversation);
      if (activeConversation === submittedConversation) await loadConversation();
    } catch (error) {
      if (status) {
        status.textContent = error instanceof Error
          ? error.message
          : 'Agent request failed.';
      }
    } finally {
      send.disabled = false;
    }
  });

  refresh?.addEventListener('click', async () => {
    await loadConversation();
    await loadMemories();
  });


  // M4c first usable slice: ACP owns the canonical programme transcript.
  // This dialog posts USER messages only; no shared model/tool invocation.
  async function showProgrammeRoom(programmeId: number, roomId: string) {
    const endpoint = '/api/v1/agent/programmes/' + programmeId
      + '/conversations/' + encodeURIComponent(roomId) + '/';
    const dialog = document.createElement('dialog');
    dialog.className = 'programme-room-dialog';
    dialog.setAttribute('aria-label', 'Shared programme conversation');
    const heading = document.createElement('h2');
    heading.textContent = 'Loading shared conversation…';
    const messages = document.createElement('div');
    messages.className = 'programme-room-messages';
    const feedback = document.createElement('p');
    feedback.className = 'small-note';
    feedback.setAttribute('role', 'status');
    const form = document.createElement('form');
    const label = document.createElement('label');
    label.textContent = 'Write a shared programme message (visible to authorized members)';
    const input = document.createElement('textarea');
    input.rows = 3;
    input.maxLength = 4000;
    input.required = true;
    input.setAttribute('aria-label', 'Shared programme message');
    label.append(input);
    const sendButton = document.createElement('button');
    sendButton.type = 'submit';
    sendButton.textContent = 'Post message';
    form.append(label, sendButton);
    const refreshButton = document.createElement('button');
    refreshButton.type = 'button';
    refreshButton.className = 'secondary';
    refreshButton.textContent = 'Refresh room';
    const close = document.createElement('button');
    close.type = 'button'; close.className = 'secondary';
    close.textContent = 'Close';
    close.addEventListener('click', () => dialog.close());
    dialog.append(heading, messages, feedback, form, refreshButton, close);
    document.body.append(dialog);
    dialog.addEventListener('close', () => dialog.remove(), { once: true });
    dialog.showModal();

    let requestGeneration = 0;
    let accessRevoked = false;
    const refreshRoom = async () => {
      const generation = ++requestGeneration;
      const reply = await fetch(endpoint, {
        credentials: 'same-origin', cache: 'no-store',
      });
      if (generation !== requestGeneration || !dialog.open) return;
      if (!reply.ok) {
        messages.replaceChildren();
        if ([401, 403, 404].includes(reply.status)) {
          accessRevoked = true;
          sendButton.disabled = true;
          input.disabled = true;
          throw new Error('Programme room access is no longer authorized.');
        }
        throw new Error('Unable to load programme conversation.');
      }
      const room = await reply.json();
      heading.textContent = String(room.title ?? 'Shared conversation');
      const entries = Array.isArray(room.messages) ? room.messages : [];
      messages.replaceChildren();
      for (const entry of entries) {
        const row = document.createElement('article');
        const author = document.createElement('strong');
        author.textContent = String(entry.author_subject ?? 'Programme member');
        const body = document.createElement('p');
        const content = entry.content;
        body.textContent = typeof content === 'string' ? content
          : typeof content?.text === 'string' ? content.text : '[Structured message]';
        row.append(author, body);
        messages.append(row);
      }
      if (!entries.length) messages.textContent = 'No shared messages yet.';
      feedback.textContent = 'Shared conversation loaded. Messages are visible only to current members.';
    };
    refreshButton.addEventListener('click', () => void refreshRoom().catch(error => {
      feedback.textContent = error instanceof Error ? error.message : 'Refresh failed.';
    }));
    form.addEventListener('submit', event => {
      event.preventDefault();
      const text = input.value.trim();
      if (!text || accessRevoked || sendButton.disabled) return;
      sendButton.disabled = true;
      feedback.textContent = 'Posting your shared message…';
      void (async () => {
        try {
          const reply = await csrfJsonFetch(endpoint + 'messages/', {
            method: 'POST',
            body: JSON.stringify({
              content: { text },
              client_message_id: crypto.randomUUID(),
            }),
          });
          if (!reply.ok) {
            if ([401, 403, 404].includes(reply.status)) {
              accessRevoked = true;
              input.disabled = true;
              messages.replaceChildren();
              throw new Error('Programme access denied or revoked. No message was posted.');
            }
            const failure = await reply.json().catch(() => ({}));
            throw new Error(failure.detail ?? 'Shared message could not be posted.');
          }
          input.value = '';
          await refreshRoom();
          feedback.textContent = 'Message saved in the canonical programme transcript.';
        } catch (error) {
          feedback.textContent = error instanceof Error
            ? error.message : 'Shared post failed.';
        } finally {
          if (!accessRevoked) sendButton.disabled = false;
        }
      })();
    });
    try {
      await refreshRoom();
    } catch (error) {
      heading.textContent = 'Unable to open shared room';
      feedback.textContent = error instanceof Error ? error.message : 'Room unavailable.';
    }
  }

  if (await requireSession()) {
    await loadSidebar();
    await loadMemories();
    await loadPersonalProfile();
    await refreshReviewedResources();
    // A sidebar menu on another portal page can navigate to the canonical
    // workspace editor without transferring credentials or workspace content.
    const projectNewChat = window.sessionStorage.getItem('qp:workspace-new-chat');
    window.sessionStorage.removeItem('qp:workspace-new-chat');
    if (projectNewChat) {
      const project = availableProjects.find(p => p.id === projectNewChat && !p.archived_at);
      if (project) beginDraft(project.id);
    }
    const editRequest = window.sessionStorage.getItem('qp:workspace-edit');
    window.sessionStorage.removeItem('qp:workspace-edit');
    if (editRequest) {
      const [kind, id] = editRequest.split(':');
      if (
        (kind === 'project' && availableProjects.some(p => p.id === id))
        || (kind === 'conversation' && availableConversations.some(c => c.id === id))
      ) {
        shell?.classList.remove('nav-collapsed');
        toggleSidebar?.setAttribute('aria-expanded', 'true');
        void openWorkspaceEditor(kind as WorkspaceKind, id);
      }
    }
    try {
      const reply = await fetch('/api/v1/me/', { credentials: 'same-origin', cache: 'no-store' });
      if (reply.ok) {
        const me = await reply.json();
        const root = document.querySelector<HTMLElement>('#programme-tree');
        if (root) {
          root.replaceChildren();
          for (const m of (me.memberships ?? [])) {
            if (m.status !== 'approved' || !m.programme?.name) continue;
            const folder = document.createElement('details');
            folder.className = 'project-group';
            const label = document.createElement('summary');
            label.textContent = m.programme.name;
            const settings = document.createElement('a');
            settings.href = '/programmes/';
            settings.textContent = 'View programme access';
            settings.className = 'small-note';
            const rooms = document.createElement('div');
            rooms.className = 'programme-rooms';
            const programmeId = Number(m.programme.id);
            let roomRequestGeneration = 0;
            const onExpand = () => {
              // Refresh the authorized list on every open, including after revocation.
              // Ignore in-flight responses from earlier open/close cycles.
              const requestGeneration = ++roomRequestGeneration;
              if (!folder.open) {
                rooms.replaceChildren();
                return;
              }
              rooms.replaceChildren();
              const loading = document.createElement('p');
              loading.className = 'small-note';
              loading.textContent = 'Loading authorized programme conversations…';
              rooms.append(loading);
              void (async () => {
                try {
                  if (!Number.isSafeInteger(programmeId) || programmeId <= 0) {
                    throw new Error('Invalid programme reference.');
                  }
                  const endpoint = '/api/v1/agent/programmes/' + programmeId + '/conversations/';
                  const reply = await fetch(endpoint, {
                    credentials: 'same-origin', cache: 'no-store',
                  });
                  if (!reply.ok) throw new Error(reply.status === 404 || reply.status === 403
                    ? 'Programme access is no longer available.'
                    : 'Shared rooms are not currently available.');
                  const data = await reply.json();
                  if (!folder.open || requestGeneration !== roomRequestGeneration) return;
                  rooms.replaceChildren();
                  const active = Array.isArray(data.items) ? data.items : [];
                  for (const room of active) {
                    if (typeof room.id !== 'string' || typeof room.title !== 'string') continue;
                    const link = document.createElement('button');
                    link.type = 'button';
                    link.className = 'programme-room-link';
                    link.textContent = room.title;
                    link.addEventListener('click', () => {
                      void showProgrammeRoom(programmeId, room.id);
                    });
                    rooms.append(link);
                  }
                  if (!rooms.childElementCount) {
                    const empty = document.createElement('p');
                    empty.className = 'small-note';
                    empty.textContent = 'No shared conversations created yet.';
                    rooms.append(empty);
                  }
                } catch (error) {
                  if (!folder.open || requestGeneration !== roomRequestGeneration) return;
                  rooms.replaceChildren();
                  const unavailable = document.createElement('p');
                  unavailable.className = 'small-note';
                  unavailable.textContent = error instanceof Error
                    ? error.message : 'Programme rooms unavailable.';
                  rooms.append(unavailable);
                }
              })();
            };
            const roomCreateForm = document.createElement('form');
            roomCreateForm.className = 'compact-actions';
            const roomTitle = document.createElement('input');
            roomTitle.placeholder = 'Shared conversation title';
            roomTitle.maxLength = 200;
            roomTitle.required = true;
            roomTitle.setAttribute('aria-label', 'New programme conversation title');
            const createRoom = document.createElement('button');
            createRoom.type = 'submit';
            createRoom.textContent = 'Create shared room';
            const roomCreateStatus = document.createElement('small');
            roomCreateStatus.className = 'small-note';
            roomCreateStatus.setAttribute('role', 'status');
            roomCreateForm.append(roomTitle, createRoom, roomCreateStatus);
            // This is a UX affordance only. Django checks current membership and
            // PI/delegate status again on every POST, independent of browser hints.
            const role = String(m.role ?? '');
            if (role === 'pi' || role === 'admin') {
              roomCreateForm.addEventListener('submit', event => {
                event.preventDefault();
                const title = roomTitle.value.trim();
                if (!title || createRoom.disabled) return;
                createRoom.disabled = true;
                roomCreateStatus.textContent = 'Creating authorized programme room…';
                void (async () => {
                  try {
                    const reply = await csrfJsonFetch(
                      '/api/v1/agent/programmes/' + programmeId + '/conversations/',
                      { method: 'POST', body: JSON.stringify({ title }) },
                    );
                    if (!reply.ok) {
                      const err = await reply.json().catch(() => ({}));
                      throw new Error([401, 403, 404].includes(reply.status)
                        ? 'PI/delegate access to this programme is no longer authorized.'
                        : (err.detail ?? 'Could not create programme room.'));
                    }
                    roomTitle.value = '';
                    roomCreateStatus.textContent = 'Shared room created.';
                    // Reread authoritative membership and list; no UI-only records.
                    if (folder.open) onExpand();
                  } catch (error) {
                    roomCreateStatus.textContent = error instanceof Error
                      ? error.message : 'Room creation failed.';
                  } finally {
                    createRoom.disabled = false;
                  }
                })();
              });
            }
            folder.addEventListener('toggle', onExpand);
            folder.append(label, settings);
            if (role === 'pi' || role === 'admin') folder.append(roomCreateForm);
            folder.append(rooms);
            root.append(folder);
          }
        }
      }
    } catch {
      // A failed membership lookup must never grant access to shared conversations.
    }


    // A mini-guide question from another portal page becomes a new canonical
    // conversation with a draft, not an auto-sent query or URL/log entry.
    const handoff = window.sessionStorage.getItem('qp:guide-draft');
    if (handoff) {
      const needsNew = window.sessionStorage.getItem('qp:guide-new-chat') === '1';
      if (needsNew) beginDraft();
      // A cross-page question is still an unsent draft. No ACP record until Send.
      if (message) {
        message.value = handoff;
        message.focus();
      }
      window.sessionStorage.removeItem('qp:guide-draft');
      window.sessionStorage.removeItem('qp:guide-new-chat');
    }
  }
</script>

