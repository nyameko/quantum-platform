---
import SiteLayout from '@nyameko/ui/SiteLayout.astro';
import Card from '@nyameko/ui/Card.astro';
---

<SiteLayout
  title="Dashboard"
  siteName="Quantum Platform"
  section="User Portal"
>
  <section class="section container">
    <p class="eyebrow">USER PORTAL</p>
    <h1>Research access dashboard</h1>
    <p id="identity" class="lede">
      Loading your account…
    </p>

    <div class="grid grid-3 dashboard-grid">
      <Card eyebrow="Identity" title="Profile" href="/profile/">
        <p id="profile-state">
          Loading profile state…
        </p>
      </Card>

      <Card eyebrow="Research" title="Programmes" href="/programmes/">
        <p id="membership-state">
          Loading programme memberships…
        </p>
      </Card>

      <Card eyebrow="Security" title="Account" href="/security/">
        <p id="security-state">
          Loading security state…
        </p>
      </Card>
    </div>

    <div class="actions">
      <a href="/">Portal home</a>
      <button id="logout" type="button">Sign out</button>
      <p id="logout-message" role="status"></p>
    </div>
  </section>
</SiteLayout>

<script>
  import {
    getSession,
    logout,
  } from '../lib/auth';

  const identity = document.querySelector<HTMLParagraphElement>('#identity');
  const profile = document.querySelector<HTMLParagraphElement>('#profile-state');
  const security = document.querySelector<HTMLParagraphElement>('#security-state');
  const memberships = document.querySelector<HTMLParagraphElement>('#membership-state');
  const logoutButton = document.querySelector<HTMLButtonElement>('#logout');
  const logoutMessage = document.querySelector<HTMLParagraphElement>('#logout-message');

  async function validateDashboard() {
    const { response } = await getSession();

    if (!response.ok) {
      window.location.replace('/login/');
      return;
    }

    const me = await fetch('/api/v1/me/', {
      credentials: 'same-origin',
      cache: 'no-store',
    });

    if (!me.ok) {
      window.location.replace('/login/');
      return;
    }

    const account = await me.json();

    if (identity) {
      const name =
        account.person?.preferred_name
        || account.person?.given_names
        || account.username
        || account.email;

      identity.textContent = `Welcome back, ${name}.`;
    }

    if (profile) {
      profile.textContent = account.person
        ? `${account.person.institution || 'Institution not set'}`
        : 'Profile not yet completed.';
    }

    if (memberships) {
      const count = account.memberships?.length ?? 0;

      memberships.textContent = count === 1
        ? '1 programme membership.'
        : `${count} programme memberships.`;
    }

    if (security) {
      security.textContent = account.email_verified
        ? 'Email verified. Open security settings.'
        : 'Email verification required.';
    }
  }

  await validateDashboard();

  window.addEventListener('pageshow', () => {
    void validateDashboard();
  });

  logoutButton?.addEventListener('click', async () => {
    logoutButton.disabled = true;

    try {
      const response = await logout();

      if (!response.ok) {
        throw new Error(`Logout failed (${response.status}).`);
      }

      window.location.replace('/login/');
    } catch (error) {
      logoutButton.disabled = false;

      if (logoutMessage) {
        logoutMessage.textContent =
          error instanceof Error
            ? error.message
            : 'Unable to sign out.';
      }
    }
  });
</script>

<style>
  h1 {
    margin: 0.4rem 0 0;
    font-size: clamp(2.7rem, 6vw, 5.5rem);
    letter-spacing: -0.05em;
  }

  .dashboard-grid {
    margin-top: 2.5rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .actions a,
  .actions button {
    min-height: 2.6rem;
    display: inline-flex;
    align-items: center;
    padding: 0 0.9rem;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  #logout-message {
    color: var(--red-strong);
  }
</style>
