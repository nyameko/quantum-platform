---
import SiteLayout from '@nyameko/ui/SiteLayout.astro';
import Button from '@nyameko/ui/Button.astro';
import Card from '@nyameko/ui/Card.astro';
---

<SiteLayout
  title="User Portal"
  siteName="Quantum Platform"
  section="User Portal"
  description="Research identity, programme membership and access management for the Quantum Platform."
>
  <section class="hero container">
    <div>
      <p class="eyebrow">QUANTUM PLATFORM · USER PORTAL</p>
      <h1>One front door to the platform.</h1>
      <p class="lede">
        Manage your research identity, security settings, programme
        membership and access to quantum-centric computing infrastructure.
      </p>

      <div class="actions" id="auth-actions">
        <Button href="/login/">Sign in</Button>
        <Button href="/account/signup/" variant="secondary">
          Create account
        </Button>
      </div>
    </div>

    <div class="status">
      <p class="eyebrow">PLATFORM STATUS</p>
      <div class="status-row">
        <span>Identity</span>
        <strong>Online</strong>
      </div>
      <div class="status-row">
        <span>MFA / Passkeys</span>
        <strong>Online</strong>
      </div>
      <div class="status-row">
        <span>Research workflow</span>
        <strong>Online</strong>
      </div>
    </div>
  </section>

  <section class="section container">
    <div class="grid grid-3">
      <Card
        eyebrow="Identity"
        title="Research profile"
        href="/profile/"
      >
        <p>
          Maintain your researcher identity and institution information.
        </p>
      </Card>

      <Card
        eyebrow="Research"
        title="Programmes"
        href="/programmes/"
      >
        <p>
          Apply as a PI or request membership in an approved programme.
        </p>
      </Card>

      <Card
        eyebrow="Security"
        title="Protected access"
        href="/security/"
      >
        <p>
          Manage password, MFA, recovery codes and WebAuthn credentials.
        </p>
      </Card>
    </div>
  </section>
</SiteLayout>

<script>
  import { getSession } from '../lib/auth';

  const actions = document.querySelector<HTMLDivElement>('#auth-actions');

  getSession().then(({ response }) => {
    if (!response.ok || !actions) return;

    actions.innerHTML = `
      <a class="portal-button primary" href="/dashboard/">
        Open dashboard
      </a>
    `;
  });
</script>

<style>
  .hero {
    min-height: 68vh;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
    align-items: center;
    gap: 4rem;
    padding-top: 6rem;
  }

  h1 {
    max-width: 900px;
    margin: 0.8rem 0 0;
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.94;
    letter-spacing: -0.06em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .status {
    padding: 1.4rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .status-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }

  .status-row:last-child {
    border-bottom: 0;
  }

  .status-row span {
    color: var(--muted);
  }

  .status-row strong {
    color: var(--success);
  }

  :global(.portal-button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.7rem;
    padding: 0.65rem 1rem;
    border-radius: 0.7rem;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
  }

  :global(.portal-button.primary) {
    border: 1px solid rgb(167 139 250 / 34%);
    background: linear-gradient(
      135deg,
      var(--purple-strong),
      #6d3fd4
    );
    color: white;
  }

  @media (max-width: 800px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-top: 5rem;
    }
  }
</style>
