---
import SiteLayout from '@nyameko/ui/SiteLayout.astro';
import Button from '@nyameko/ui/Button.astro';
import Card from '@nyameko/ui/Card.astro';
---

<SiteLayout title="Quantum Platform" siteName="Quantum Platform" section="User Portal"
  description="A research portal for identity, programme access, Jupyter and scheduler-backed quantum/HPC workflows.">

  <section id="home-loading" class="section container" role="status">Opening Quantum Platform…</section>

  <section id="public-home" class="hero container" hidden>
    <div>
      <p class="eyebrow">QUANTUM PLATFORM · RESEARCH ACCESS</p>
      <h1>One front door to quantum-centric research.</h1>
      <p class="lede">
        Research identity, approved programme access, secure connections, Jupyter notebooks
        and scheduler-backed scientific workflows.
      </p>
      <div class="actions">
        <Button href="/login/">Sign in</Button>
        <Button href="/account/signup/" variant="secondary">Create account</Button>
      </div>
    </div>
    <div class="public-guide">
      <p class="eyebrow">GET ACCESS</p>
      <h2>Start with a research account</h2>
      <p>Create your profile, join or apply for a research programme, and then connect to the available services.</p>
      <p class="muted">CPU, GPU and QPU access depends on approved entitlements and availability.</p>
    </div>
  </section>

  <section id="authenticated-home" class="section container auth-home" hidden>
    <div class="welcome-heading">
      <div>
        <p class="eyebrow">QUANTUM PLATFORM · YOUR WORKSPACE</p>
        <h1>Research home</h1>
        <p id="identity" class="lede">Loading your account…</p>
      </div>
    </div>

    <div class="grid grid-3 home-grid">
      <Card icon="/assets/guide/identity.svg" description="Create and maintain your research profile, institution and verified research identity." eyebrow="Identity" title="Research profile" href="/profile/">
        <p id="profile-state">Loading profile state…</p>
      </Card>
      <Card icon="/assets/guide/research.svg" description="Join a research programme, apply as PI and review approved memberships." eyebrow="Research" title="Programmes" href="/programmes/">
        <p id="membership-state">Loading programme memberships…</p>
      </Card>
      <Card icon="/assets/guide/security.svg" description="Verify email, enable multi-factor authentication, and register public SSH and WireGuard keys." eyebrow="Security" title="Account security" href="/security/">
        <ul id="security-state" class="home-security-status" aria-label="Your account security status">
          <li><span id="home-email-icon" class="factor-icon" aria-hidden="true">·</span> Email verified</li>
          <li><span id="home-mfa-icon" class="factor-icon" aria-hidden="true">·</span> MFA configured</li>
          <li><span id="home-keys-icon" class="factor-icon" aria-hidden="true">·</span> SSH &amp; WireGuard keys registered</li>
        </ul>
      </Card>
      <Card icon="/assets/guide/jupyter-brand.svg" brandIcon description="Launch a managed Jupyter research environment to run existing scientific Python SDKs." eyebrow="Jupyter" title="Workbench" href="/workbench/">
        <p>Launch or resume your lightweight Kubernetes research notebook.</p>
      </Card>
      <Card icon="/assets/guide/slurm-brand.svg" brandIcon description="Submit and inspect scheduled CPU research jobs and, when approved, GPU jobs through Slurm." eyebrow="Slurm" title="Runs" href="/runs/">
        <p>Submit and inspect durable scheduler-backed scientific runs.</p>
      </Card>
      <Card icon="/assets/guide/access.svg" description="Check entitlement and allocation status for A100, H200, external HPC and remote QPUs." eyebrow="Resource Access" title="Access & entitlements" href="/access/">
        <p>Check CPU/GPU/QPU provider access and request resources as verification becomes available.</p>
      </Card>
    </div>
  </section>
</SiteLayout>

<script>
  import { getSession, sessionIsAuthenticated } from '../lib/auth';

  const loadingHome = document.querySelector<HTMLElement>('#home-loading');
  const publicHome = document.querySelector<HTMLElement>('#public-home');
  const authHome = document.querySelector<HTMLElement>('#authenticated-home');
  const identity = document.querySelector<HTMLElement>('#identity');
  const profile = document.querySelector<HTMLElement>('#profile-state');
  function statusIcon(id: string, ok: boolean) {
    const icon = document.getElementById(id);
    if (!icon) return;
    icon.textContent = ok ? '✓' : '✕';
    icon.classList.toggle('verified', ok);
    icon.classList.toggle('missing', !ok);
    icon.parentElement?.setAttribute('aria-label',
      (ok ? 'Configured: ' : 'Needs setup: ') + (icon.parentElement?.textContent?.replace(/[✓✕·]/g, '').trim() ?? ''));
  }
  const memberships = document.querySelector<HTMLElement>('#membership-state');

  async function showHome() {
    try {
      const { response, payload } = await getSession();
      if (!sessionIsAuthenticated(response, payload)) {
        if (publicHome) publicHome.hidden = false;
        return;
      }
      const me = await fetch('/api/v1/me/', { credentials: 'same-origin', cache: 'no-store' });
      if (!me.ok) {
        if (publicHome) publicHome.hidden = false;
        return;
      }
      const account = await me.json();
      if (identity) {
        const name = account.person?.preferred_name || account.person?.given_names
          || account.username || account.email;
        identity.textContent = 'Welcome back, ' + name + '.';
      }
      if (profile) {
        profile.textContent = account.person
          ? (account.person.institution || 'Institution not set')
          : 'Complete your research profile.';
      }
      if (memberships) {
        const count = account.memberships?.length ?? 0;
        memberships.textContent = count === 1
          ? '1 programme membership.' : count + ' programme memberships.';
      }
      statusIcon('home-email-icon', account.email_verified === true);
      statusIcon('home-mfa-icon', account.mfa_configured === true);
      statusIcon('home-keys-icon',
        account.ssh_key_registered === true && account.wireguard_key_registered === true);
      if (publicHome) publicHome.hidden = true;
      if (authHome) authHome.hidden = false;
    } catch {
      if (publicHome) publicHome.hidden = false;
    } finally {
      if (loadingHome) loadingHome.hidden = true;
    }
  }

  void showHome();
</script>

<style>
  [hidden] { display: none !important; }
  .hero {
    min-height: 68vh; display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, .65fr);
    align-items: center; gap: 3rem; padding-top: 5rem;
  }
  h1 { font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -.05em; line-height: 1.05; margin: .6rem 0; }
  .actions { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .public-guide { padding: 1.4rem; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); }
  .muted { color: var(--muted); }
  .auth-home { padding-top: 2rem; }
  .home-security-status { display:grid; list-style:none; margin:0; padding:0; gap:.42rem; }
  .home-security-status li { display:flex; align-items:center; gap:.48rem; font-size:.84rem; }
  .factor-icon { display:inline-grid; place-items:center; width:1.2rem; height:1.2rem; font-weight:800; }
  .factor-icon.verified { color:#32b879; }
  .factor-icon.missing { color:#ed6570; }
  .welcome-heading { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .home-grid { margin-top: 2rem; }
  @media (max-width: 800px) {
    .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 3rem; }
    .welcome-heading { align-items: start; flex-direction: column; }
  }
</style>
