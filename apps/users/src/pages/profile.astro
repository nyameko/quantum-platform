---
import SiteLayout from '@nyameko/ui/SiteLayout.astro';
---

<SiteLayout title="Profile" siteName="Quantum Platform" section="User Portal">
  <section class="section container page-shell">
    <p class="eyebrow">IDENTITY</p>
    <h1>Research profile</h1>
    <p class="lede">
      Your username is an immutable infrastructure identity. Human profile
      details can change without renaming SSH, Slurm or historical records.
    </p>

    <form id="profile-form">
      <label class="wide">
        Username
        <input name="username" readonly aria-readonly="true" />
        <small>Automatically generated at registration; cannot be changed.</small>
      </label>

      <label>
        Given names
        <input name="given_names" required />
      </label>

      <label>
        Family name
        <input name="family_name" required />
      </label>

      <label class="wide">
        Primary institution
        <select name="institution" id="institution" required></select>
      </label>

      <label class="wide">
        ORCID
        <input name="orcid" placeholder="0000-0000-0000-0000" />
      </label>

      <div class="actions wide">
        <button type="submit">Save profile</button>
        <a href="/dashboard/">Back to dashboard</a>
      </div>

      <p id="message" class="wide" role="status"></p>
    </form>
  </section>
</SiteLayout>

<script>
  import { csrfJsonFetch, requireSession } from '../lib/auth';
  import {
    loadInstitutions,
    populateInstitutionSelect,
  } from '../lib/institutions';

  const form = document.querySelector<HTMLFormElement>('#profile-form');
  const message = document.querySelector<HTMLParagraphElement>('#message');
  const institution = document.querySelector<HTMLSelectElement>('#institution');

  async function initialise() {
    if (!(await requireSession())) return;

    const [response, institutions] = await Promise.all([
      fetch('/api/v1/me/', {
        credentials: 'same-origin',
        cache: 'no-store',
      }),
      loadInstitutions(),
    ]);

    if (!response.ok || !form) return;

    const me = await response.json();
    const username = form.elements.namedItem('username') as HTMLInputElement | null;
    if (username) username.value = me.username ?? '';

    const person = me.person;
    for (const name of ['given_names', 'family_name', 'orcid']) {
      const input = form.elements.namedItem(name) as HTMLInputElement | null;
      if (input) input.value = person?.[name] ?? '';
    }

    if (institution) {
      populateInstitutionSelect(
        institution,
        institutions,
        person?.institution ?? '',
      );
    }
  }

  void initialise();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const data = new FormData(form);
    data.delete('username');

    const response = await csrfJsonFetch('/api/v1/profile/', {
      method: 'PUT',
      body: JSON.stringify(Object.fromEntries(data.entries())),
    });
    const payload = await response.json().catch(() => ({}));

    if (message) {
      message.textContent = response.ok
        ? 'Profile saved.'
        : payload.detail || 'Unable to save profile.';
    }
  });
</script>

<style>
  .page-shell { max-width:56rem; }
  h1 { margin:.4rem 0 0; font-size:clamp(2.8rem,6vw,5rem); letter-spacing:-.05em; }
  form { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; margin-top:2.5rem; }
  label { display:grid; gap:.45rem; color:var(--muted-strong); }
  .wide { grid-column:1/-1; }
  input, select { box-sizing:border-box; width:100%; padding:.8rem; border:1px solid var(--border); border-radius:.65rem; background:var(--background); color:var(--text); font:inherit; }
  input[readonly] { color:var(--purple); background:var(--background-soft); }
  small { color:var(--muted); }
  .actions { display:flex; align-items:center; gap:1rem; margin-top:.5rem; }
  button { min-height:2.8rem; padding:0 1rem; border:0; border-radius:.65rem; background:var(--purple-strong); color:#fff; font-weight:700; cursor:pointer; }
  .actions a { color:var(--muted-strong); }
  #message { color:var(--muted-strong); }
  @media (max-width:680px) { form { grid-template-columns:1fr; } .wide { grid-column:auto; } }
</style>
