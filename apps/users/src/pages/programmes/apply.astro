---
import SiteLayout from '@nyameko/ui/SiteLayout.astro';
---

<SiteLayout
  title="PI Application"
  siteName="Quantum Platform"
  section="User Portal"
>
  <section class="section container page-shell">
    <p class="eyebrow">RESEARCH PROGRAMME</p>
    <h1>Apply as a Principal Investigator</h1>
    <p class="lede">
      Submit a research programme for platform administrator approval.
    </p>

    <form id="application-form">
      <label>
        Given names
        <input name="given_names" required />
      </label>

      <label>
        Family name
        <input name="family_name" required />
      </label>

      <label>
        Institution
        <input name="institution" required />
      </label>

      <label>
        Department
        <input name="department" />
      </label>

      <label>
        Programme name
        <input name="programme_name" required />
      </label>

      <label>
        Programme acronym
        <input name="programme_acronym" />
      </label>

      <label class="wide">
        Programme description
        <textarea name="programme_description" rows="7" required></textarea>
      </label>

      <div class="actions wide">
        <button type="submit">Submit application</button>
        <a href="/programmes/">Back to programmes</a>
      </div>

      <p id="message" class="wide" role="status"></p>
    </form>
  </section>
</SiteLayout>

<script>
  import {
    csrfJsonFetch,
    requireSession,
  } from '../../lib/auth';

  const form = document.querySelector<HTMLFormElement>('#application-form');
  const message = document.querySelector<HTMLParagraphElement>('#message');

  if (await requireSession()) {
    const meResponse = await fetch('/api/v1/me/', {
      credentials: 'same-origin',
      cache: 'no-store',
    });

    if (meResponse.ok && form) {
      const me = await meResponse.json();

      if (me.person) {
        for (const name of [
          'given_names',
          'family_name',
          'institution',
          'department',
        ]) {
          const field = form.elements.namedItem(name) as HTMLInputElement | null;
          if (field) field.value = me.person[name] ?? '';
        }
      }
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const body = Object.fromEntries(new FormData(form).entries());

    const response = await csrfJsonFetch(
      '/api/v1/pi-applications/submit/',
      {
        method: 'POST',
        body: JSON.stringify(body),
      },
    );

    const payload = await response.json().catch(() => ({}));

    if (message) {
      message.textContent = response.ok
        ? 'PI application submitted for review.'
        : payload.detail || 'Unable to submit PI application.';
    }

    if (response.ok) {
      form.reset();
    }
  });
</script>

<style>
  .page-shell {
    max-width: 60rem;
  }

  h1 {
    margin: 0.4rem 0 0;
    font-size: clamp(2.8rem, 6vw, 5rem);
    letter-spacing: -0.05em;
  }

  form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  label {
    display: grid;
    gap: 0.45rem;
  }

  input,
  textarea {
    box-sizing: border-box;
    width: 100%;
    padding: 0.8rem;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    background: var(--background);
    color: var(--text);
    font: inherit;
  }

  .wide {
    grid-column: 1 / -1;
  }

  .actions {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }

  button,
  .actions a {
    min-height: 2.7rem;
    display: inline-flex;
    align-items: center;
    padding: 0 1rem;
    border-radius: 0.65rem;
    text-decoration: none;
  }

  button {
    border: 0;
    background: var(--purple-strong);
    color: white;
    font-weight: 700;
    cursor: pointer;
  }

  .actions a {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
  }

  #message {
    color: var(--muted-strong);
  }

  @media (max-width: 680px) {
    form {
      grid-template-columns: 1fr;
    }
  }
</style>
