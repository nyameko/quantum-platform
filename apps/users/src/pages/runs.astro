---
import SiteLayout from '@nyameko/ui/SiteLayout.astro';
---

<SiteLayout title="Runs" siteName="Quantum Platform" section="User Portal">
  <section class="section container page-shell">
    <p class="eyebrow">EXECUTION</p>
    <h1>Research runs</h1>
    <p class="lede">
      Submit durable workloads without tying them to the lifetime of your notebook.
    </p>

    <article class="panel submit-panel">
      <div>
        <p class="eyebrow">CPU SMALL</p>
        <h2>CPU smoke test</h2>
        <p>
          A credential-free quantum-workflows run that validates
          Quantum Platform → restricted gateway → Slurm → shared results.
        </p>
      </div>
      <button id="submit" type="button">Submit cpu-smoke</button>
      <p id="submit-message" role="status"></p>
    </article>

    <article class="panel submit-panel">
      <div>
        <p class="eyebrow">CPU SMALL · QUANTUM FOUNDATIONS</p>
        <h2>Bell-state experiment</h2>
        <p>
          Run a two-qubit Bell-state experiment with Qiskit Aer through Slurm.
          Inspect the measured correlations and reproducible results after completion.
          No provider account or GPU allocation is needed.
        </p>
      </div>
      <button id="submit-bell" type="button">Run Bell experiment on CPU</button>
      <p id="submit-bell-message" role="status" aria-live="polite"></p>
    </article>

    <section class="runs">
      <div class="section-heading">
        <h2>Recent runs</h2>
        <button id="refresh" type="button" class="secondary">Refresh</button>
      </div>
      <div id="run-list"></div>
    </section>

    <section class="runs" aria-label="Slurm scheduler history">
      <div class="section-heading">
        <div>
          <h2>Slurm scheduler history</h2>
          <p class="help">Your last seven days of jobs, including direct submissions from login nodes. Jobs already listed above are not repeated.</p>
        </div>
      </div>
      <p id="slurm-history-status" role="status" aria-live="polite"></p>
      <div id="slurm-history-list" aria-live="polite"></div>
    </section>

    <a class="back" href="/dashboard/">Back to dashboard</a>
  </section>
</SiteLayout>

<script>
  import { csrfJsonFetch, requireSession } from '../lib/auth';

  type Run = {
    id: string;
    offering: string;
    state: string;
    scheduler_job_id?: string | null;
    result_path: string;
    error_message?: string | null;
  };

  const submit = document.querySelector<HTMLButtonElement>('#submit');
  const submitMessage = document.querySelector<HTMLParagraphElement>('#submit-message');
  const submitBell = document.querySelector<HTMLButtonElement>('#submit-bell');
  const submitBellMessage = document.querySelector<HTMLParagraphElement>('#submit-bell-message');
  const refresh = document.querySelector<HTMLButtonElement>('#refresh');
  const list = document.querySelector<HTMLDivElement>('#run-list');
  const slurmList = document.querySelector<HTMLDivElement>('#slurm-history-list');
  const slurmStatus = document.querySelector<HTMLElement>('#slurm-history-status');

  type SlurmJob = {
    job_id: string; job_name: string; partition: string; state: string;
    exit_code: string; elapsed: string; submitted_at: string; nodes: string;
  };

  function renderSlurmHistory(jobs: SlurmJob[], platformIds: Set<string>) {
    if (!slurmList) return;
    slurmList.replaceChildren();
    const fromCli = jobs.filter(job => !platformIds.has(job.job_id));
    if (!fromCli.length) {
      const empty = document.createElement('p');
      empty.textContent = 'No additional Slurm CLI jobs in the last seven days.';
      slurmList.append(empty);
      return;
    }
    for (const job of fromCli) {
      const item = document.createElement('article');
      item.className = 'run';
      const heading = document.createElement('div');
      const title = document.createElement('strong');
      title.textContent = job.job_name || 'Slurm job';
      const state = document.createElement('span');
      state.className = 'state';
      state.textContent = job.state;
      heading.append(title, state);
      const details = document.createElement('code');
      details.textContent = 'Slurm ' + job.job_id + ' · '
        + job.partition + ' · ' + job.elapsed + ' · ' + job.nodes;
      const when = document.createElement('small');
      when.textContent = 'Submitted: ' + job.submitted_at
        + ' · Exit code: ' + job.exit_code + ' · Source: Slurm CLI';
      item.append(heading, details, when);
      slurmList.append(item);
    }
  }

  function render(runs: Run[]) {
    if (!list) return;
    list.replaceChildren();

    if (!runs.length) {
      const empty = document.createElement('p');
      empty.textContent = 'No runs yet.';
      list.append(empty);
      return;
    }

    for (const run of runs) {
      const item = document.createElement('article');
      item.className = 'run';

      const heading = document.createElement('div');
      const title = document.createElement('strong');
      title.textContent = run.offering;
      const state = document.createElement('span');
      state.className = 'state';
      state.textContent = run.state;
      heading.append(title, state);

      const meta = document.createElement('code');
      meta.textContent = run.scheduler_job_id
        ? `Slurm ${run.scheduler_job_id} · ${run.result_path}`
        : run.result_path;

      item.append(heading, meta);

      if (run.error_message) {
        const error = document.createElement('p');
        error.textContent = run.error_message;
        item.append(error);
      }

      if (!['completed', 'failed', 'cancelled'].includes(run.state) && run.scheduler_job_id) {
        const cancel = document.createElement('button');
        cancel.type = 'button';
        cancel.className = 'secondary';
        cancel.textContent = 'Cancel';
        cancel.addEventListener('click', async () => {
          cancel.disabled = true;
          await csrfJsonFetch(`/api/v1/executions/${run.id}/cancel/`, {
            method: 'POST',
            body: JSON.stringify({}),
          });
          await load();
        });
        item.append(cancel);
      }

      list.append(item);
    }
  }

  async function load() {
    let platformIds = new Set<string>();
    try {
      const response = await fetch('/api/v1/executions/', {
        credentials: 'same-origin', cache: 'no-store',
      });
      if (response.ok) {
        const runs: Run[] = await response.json();
        render(runs);
        platformIds = new Set(
          runs.map(item => item.scheduler_job_id).filter(
            (id): id is string => Boolean(id),
          ),
        );
      }
    } catch {
      // The scheduler history below is independently useful.
    }
    if (slurmStatus) slurmStatus.textContent = 'Loading Slurm accounting…';
    try {
      const response = await fetch('/api/v1/executions/slurm-history/', {
        credentials: 'same-origin', cache: 'no-store',
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(
        payload.detail ?? 'Slurm history is unavailable.'
      );
      renderSlurmHistory(payload.items ?? [], platformIds);
      if (slurmStatus) slurmStatus.textContent =
        'Showing scheduler jobs for your authenticated research account only.';
    } catch (error) {
      if (slurmStatus) slurmStatus.textContent = error instanceof Error
        ? error.message : 'Scheduler history unavailable.';
      slurmList?.replaceChildren();
    }
  }

  async function submitOffering(
    button: HTMLButtonElement | null,
    message: HTMLParagraphElement | null,
    offering: 'cpu-smoke' | 'bell-aer',
  ) {
    if (!button) return;
    button.disabled = true;
    if (message) message.textContent = 'Submitting through Slurm…';

    try {
      const response = await csrfJsonFetch(`/api/v1/executions/${offering}/`, {
        method: 'POST',
        body: JSON.stringify({}),
      });
      const payload = await response.json().catch(() => ({}));

      if (response.ok) {
        if (message) message.textContent = `Submitted as Slurm job ${payload.scheduler_job_id}.`;
        await load();
      } else if (message) {
        const explanation = payload.error_message ?? payload.detail;
        message.textContent = explanation
          ? 'Slurm did not accept the job: ' + explanation
          : 'Submission failed. Check recent runs for the recorded error and retry after the gateway is corrected.';
        await load();
      }
    } catch {
      if (message) message.textContent = 'Could not reach the execution service.';
    } finally {
      button.disabled = false;
    }
  }

  submit?.addEventListener('click', () => void submitOffering(submit, submitMessage, 'cpu-smoke'));
  submitBell?.addEventListener(
    'click',
    () => void submitOffering(submitBell, submitBellMessage, 'bell-aer'),
  );

  refresh?.addEventListener('click', () => void load());

  if (await requireSession()) {
    await load();
  }
</script>

<style>
  .page-shell { max-width:70rem; }
  h1 { margin:.4rem 0 0; font-size:clamp(2.8rem,6vw,5rem); letter-spacing:-.05em; }
  .panel, .run { border:1px solid var(--border); border-radius:1rem; background:var(--surface); }
  .submit-panel { margin-top:2rem; padding:1.5rem; display:grid; gap:1rem; }
  .runs { margin-top:2.5rem; }
  .section-heading, .run > div { display:flex; justify-content:space-between; gap:1rem; align-items:center; }
  #run-list, #slurm-history-list { display:grid; gap:.8rem; margin-top:1rem; }
  .help, #slurm-history-status, .run small { color:var(--muted-strong); }
  .run { display:grid; gap:.6rem; padding:1rem; }
  .run code { overflow-wrap:anywhere; color:var(--muted-strong); }
  .state { padding:.2rem .5rem; border:1px solid var(--border); border-radius:999px; font-size:.8rem; }
  button { min-height:2.7rem; padding:0 .9rem; border:0; border-radius:.65rem; background:var(--purple-strong); color:#fff; font-weight:700; cursor:pointer; width:max-content; }
  button.secondary { background:var(--surface); color:var(--text); border:1px solid var(--border); }
  button:disabled { opacity:.6; cursor:wait; }
  #submit-message { min-height:1.4rem; color:var(--muted-strong); }
  .back { display:inline-block; margin-top:1.5rem; color:var(--muted-strong); }
</style>
