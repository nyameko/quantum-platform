{
  "name": "quantum-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Public web and research platform for quantum-centric computing at Nyameko.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:blog": "npm run dev -w @nyameko/blog",
    "dev:users": "npm run dev -w @nyameko/users",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "astro": "^7.3.2",
    "prettier": "^3.7.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
