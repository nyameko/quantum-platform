---
interface Props {
  eyebrow?: string;
  title?: string;
  href?: string;
  class?: string;
  icon?: string;
  brandIcon?: boolean;
  description?: string;
}

const { eyebrow, title, href, icon, description, brandIcon = false, class: className = '' } = Astro.props;
---

{href ? (
  <a class={`card ${className}`} href={href} data-help={description} aria-description={description}
    {icon && (brandIcon ? <img class="card-brand-visual" src={icon} alt="" aria-hidden="true" /> : <span class="card-visual" aria-hidden="true" style={`--card-icon:url("${icon}")`} />)}
    {eyebrow && <p class="card-eyebrow">{eyebrow}</p>}
    {title && <h3>{title}</h3>}
    <div class="card-body"><slot /></div>
  </a>
) : (
  <article class={`card ${className}`}>
    {icon && (brandIcon ? <img class="card-brand-visual" src={icon} alt="" aria-hidden="true" /> : <span class="card-visual" aria-hidden="true" style={`--card-icon:url("${icon}")`} />)}
    {eyebrow && <p class="card-eyebrow">{eyebrow}</p>}
    {title && <h3>{title}</h3>}
    <div class="card-body"><slot /></div>
  </article>
)}

<style>
  .card {
    position: relative;
    display: block;
    min-height: 10.6rem;
    padding: 1.4rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: linear-gradient(160deg, rgb(255 255 255 / 3%), rgb(255 255 255 / 1%)), var(--surface);
    box-shadow: 0 12px 40px rgb(0 0 0 / 12%);
    text-decoration: none;
    transition: border-color 160ms ease, transform 160ms ease, background 160ms ease;
  }

  a.card:hover {
    border-color: var(--border-strong);
    background: var(--surface-elevated);
    transform: translateY(-2px);
  }

  .card-visual {
    display: block; width: 3.2rem; height: 3.2rem;
    margin: 0 0 1.15rem;
    background: currentColor; opacity: .48;
    mask-image: var(--card-icon);
    mask-size: contain; mask-position: center; mask-repeat: no-repeat;
    -webkit-mask-image: var(--card-icon);
    -webkit-mask-size: contain; -webkit-mask-position: center;
    -webkit-mask-repeat: no-repeat;
  }
  .card-brand-visual {
    display:block; width:3.2rem; height:3.2rem; margin:0 0 1.15rem;
    object-fit:contain;
  }
  /* Descriptions remain hover/focus hints; no redundant information glyphs. */
  a.card[data-help]:hover::after, a.card[data-help]:focus-visible::after {
    content:attr(data-help); position:absolute; z-index:35;
    right:1rem; top:3.2rem; width:min(18rem, 65vw); box-sizing:border-box;
    padding:.8rem; border-radius:.65rem; border:1px solid var(--border-strong);
    background:var(--surface-elevated); color:var(--text);
    box-shadow:0 10px 28px rgb(0 0 0 / 30%);
    font-size:.85rem; font-weight:400; line-height:1.45; pointer-events:none;
  }
  /* The first column sits beside Quantum Guide; shift its hints right. */
  a.card.tooltip-right[data-help]:hover::after,
  a.card.tooltip-right[data-help]:focus-visible::after {
    left:calc(100% - 1.4rem); right:auto;
  }
  .card-eyebrow {
    margin: 0 0 0.65rem;
    color: var(--purple);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.25;
  }

  .card-body {
    margin-top: 0.7rem;
    color: var(--muted);
  }

  .card-body :global(p) {
    margin: 0;
  }
</style>