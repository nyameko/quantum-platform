<button id="rail-expand-handle" type="button" hidden
  title="Expand Quantum Guide" aria-label="Expand Quantum Guide">
  <span class="rail-symbol panel" aria-hidden="true"></span> Guide
</button>
<aside id="quantum-guide-rail" class="quantum-guide-rail" aria-label="Quantum Guide" hidden>
  <div class="rail-heading">
    <a href="/agent/" class="rail-title" title="Open Quantum Guide">Quantum Guide</a>
    <div class="rail-heading-actions">
      <button type="button" id="rail-search-toggle" class="rail-tool rail-search-symbol"
        title="Search projects and chats" aria-label="Search projects and chats"
        aria-expanded="false"><span class="rail-symbol search"></span></button>
      <button type="button" id="rail-collapse" class="rail-tool"
        title="Collapse Quantum Guide" aria-label="Collapse Quantum Guide">
        <span class="rail-symbol panel"></span>
      </button>
      <button type="button" id="rail-close" class="rail-close" aria-label="Close Guide navigation">×</button>
    </div>
  </div>
  <p class="rail-subtitle">Your research assistant</p>
  <label id="rail-search-field" class="rail-search-field" hidden>
    <span class="sr-only">Find projects, programmes, conversations</span>
    <input id="rail-search" type="search" placeholder="Search your workspace…" autocomplete="off" />
  </label>
  <form id="rail-prompt-form" class="rail-prompt">
    <label for="rail-prompt">Ask Guide</label>
    <textarea id="rail-prompt" rows="3" maxlength="4000"
      placeholder="What would you like to explore or work on?"></textarea>
    <div class="rail-prompt-actions">
      <button id="rail-send" type="submit">Send</button>
      <button id="rail-new-chat" type="button" class="rail-secondary">New chat</button>
    </div>
  </form>
  <p id="rail-chat-status" class="rail-note" role="status" aria-live="polite">
    Messages are stored in your ACP conversation, not in this browser panel.
  </p>
  <div id="rail-inline-transcript" class="rail-inline-transcript" role="log"
    aria-live="polite" aria-label="Quantum Guide conversation"></div>
  <a id="rail-open-conversation" class="rail-all" href="/agent/">Open in full Guide</a>

  <div class="rail-section-title">
    <h2>Projects</h2>
    <a href="/agent/" aria-label="Manage research projects" title="Manage research projects">+</a>
  </div>
  <nav id="rail-projects" aria-label="Your research projects">
    <p class="rail-note">Loading projects…</p>
  </nav>
  <h2 class="rail-section-title">Programmes</h2>
  <nav id="rail-programmes" aria-label="Approved research programmes"></nav>
  <h2 class="rail-section-title">Recent chats</h2>
  <nav id="rail-recents" class="rail-vertical-list" aria-label="Recent research conversations"></nav>
  <a class="rail-all" href="/notebooks/">Explore scientific notebooks</a>
</aside>

<style>
  .quantum-guide-rail {
    position: fixed; z-index: 18; top: 76px; left: .5rem;
    width: 16.5rem; height: calc(100vh - 85px); overflow-y: auto;
    padding: 1rem; box-sizing: border-box;
    border: 1px solid var(--border); border-radius: .85rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .quantum-guide-rail[hidden], #rail-expand-handle[hidden] { display: none !important; }
  #rail-expand-handle { position:fixed; z-index:30; top:5.25rem; left:.5rem;
    display:flex; align-items:center; gap:.4rem; padding:.55rem .7rem;
    border:1px solid var(--border); border-radius:.65rem; color:var(--text);
    background:var(--surface); box-shadow:var(--shadow); cursor:pointer; }
  #rail-expand-handle:hover { background:var(--background-soft); }
  #rail-expand-handle .rail-symbol { background:currentColor; }
  .rail-heading { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
  .rail-heading-actions { display:flex; align-items:center; gap:.2rem; }
  .rail-tool { width:2rem; height:2rem; display:grid; place-items:center; cursor:pointer;
    background:transparent; border:1px solid transparent; border-radius:.5rem; color:var(--text); }
  .rail-tool:hover, .rail-tool:focus-visible { border-color:var(--border); background:var(--background-soft); }
  .rail-symbol { display:inline-block; width:1.15rem; height:1.15rem; background:currentColor;
    opacity:.65; mask-position:center; mask-size:contain; mask-repeat:no-repeat;
    -webkit-mask-position:center; -webkit-mask-size:contain; -webkit-mask-repeat:no-repeat; }
  .rail-symbol.search { mask-image:url('/assets/guide/search.svg');
    -webkit-mask-image:url('/assets/guide/search.svg'); }
  .rail-symbol.panel { mask-image:url('/assets/guide/panel.svg');
    -webkit-mask-image:url('/assets/guide/panel.svg'); }
  .rail-search-field { display:block; margin:.6rem 0; }
  .rail-search-field[hidden] { display:none; }
  .rail-search-field input { box-sizing:border-box; width:100%; padding:.6rem;
    border:1px solid var(--border); border-radius:.6rem; background:var(--background); color:var(--text); }
  .sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); }
  .rail-vertical-list, .quantum-guide-rail nav { display:grid; grid-template-columns:minmax(0,1fr);
    align-content:start; gap:.1rem; }
  .rail-title { text-decoration: none; color: var(--text); font-weight: 800; }
  .rail-subtitle, .rail-note { font-size: .75rem; color: var(--muted); }
  .rail-subtitle { margin: .25rem 0 .9rem; }
  .rail-prompt { display: grid; gap: .5rem; margin-bottom: .3rem; }
  .rail-prompt label { font-size: .8rem; font-weight: 700; }
  .rail-prompt textarea {
    resize: vertical; min-height: 4rem; padding: .55rem;
    border: 1px solid var(--border); border-radius: .55rem;
    color: var(--text); background: var(--background); font: inherit;
  }
  .rail-prompt button {
    padding: .6rem; border: 0; border-radius: .6rem;
    background: var(--purple-strong); color: white; cursor: pointer;
  }
  .rail-prompt-actions { display: flex; flex-wrap: wrap; gap: .4rem; }
  .rail-prompt .rail-secondary { background: var(--background); color: var(--text); border: 1px solid var(--border); }
  .rail-prompt button:disabled { opacity: .6; cursor: wait; }
  .rail-inline-transcript { max-height: min(33vh, 22rem); overflow-y: auto; display: grid;
    gap: .35rem; margin-top: .55rem; font-size: .8rem; }
  .rail-inline-message { padding: .55rem; border-radius: .5rem; overflow-wrap: anywhere;
    white-space: pre-wrap; background: var(--background); }
  .rail-inline-message.assistant { border: 1px solid var(--border); }
  .rail-inline-message.user { border: 1px solid var(--purple-strong); }
  .rail-inline-message strong { display: block; font-size: .72rem; margin-bottom: .2rem; }
  .rail-inline-transcript:empty { display: none; }
  .rail-close { display: none; border: 0; font-size: 1.2rem; background: transparent; color: var(--text); cursor: pointer; }
  .rail-section-title { margin: 1.2rem 0 .4rem; display: flex; align-items: center; justify-content: space-between; font-size: .85rem; }
  .rail-section-title h2 { font-size: inherit; margin: 0; }
  .rail-section-title a { color: var(--text); font-size: 1.1rem; text-decoration: none; }
  .rail-all { display: inline-block; margin-top: .8rem; font-size: .8rem; color: var(--muted-strong); }
  .rail-chat {
    display: flex; align-items:center; gap:.5rem; width: 100%; text-align: left; padding: .4rem .5rem;
    margin-bottom: .15rem; border: 0; border-radius: .4rem;
    background: transparent; color: var(--text); cursor: pointer;
    font: inherit; font-size: .78rem; overflow-wrap: anywhere;
  }
  .rail-chat::before { content:''; flex:0 0 1rem; height:1rem; background:currentColor; opacity:.5;
    mask:url('/assets/guide/chat.svg') center / contain no-repeat;
    -webkit-mask:url('/assets/guide/chat.svg') center / contain no-repeat; }
  .rail-chat:hover, .rail-chat:focus-visible { background: var(--background-soft); }
  .rail-folder summary { display:flex; align-items:center; gap:.5rem; list-style:none; }
  .rail-folder summary::before { content:''; flex:0 0 1rem; height:1rem;
    background:currentColor; opacity:.5; mask:url('/assets/guide/folder.svg') center / contain no-repeat;
    -webkit-mask:url('/assets/guide/folder.svg') center / contain no-repeat; }
  .rail-folder { margin: .5rem 0; }
  .rail-folder summary { font-size: .82rem; cursor: pointer; font-weight: 700; overflow-wrap: anywhere; }
  .rail-folder-children { margin-left: .8rem; border-left: 1px solid var(--border); padding-left: .25rem; }
  .rail-chat-row, .rail-folder-row { display:flex; align-items:center; min-width:0; gap:.2rem; width:100%; }
  .rail-chat-row > .rail-actions-wrap, .rail-folder-row > .rail-actions-wrap { margin-left:auto; }
  .rail-folder-row > .rail-folder { overflow:hidden; }
  .rail-folder > summary { max-width:100%; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .rail-folder > summary::before { flex-shrink:0; }
  .rail-chat-row > .rail-chat, .rail-folder-row > .rail-folder { flex:1; min-width:0; }

  .rail-actions-wrap { display:inline-flex; flex:0 0 auto; }
  .rail-actions { flex:0 0 auto; border:1px solid transparent; border-radius:.45rem;
    background:transparent; color:var(--text); cursor:pointer; min-width:1.95rem; height:1.95rem;
    display:grid; place-items:center; font-size:1rem; font-family:inherit; }
  .rail-actions:hover, .rail-actions:focus-visible { background:var(--background-soft); border-color:var(--border); }
  .rail-action-list:popover-open {
    position:fixed; inset:unset; z-index:1000; width:13.5rem; max-height:min(65vh,25rem); overflow-y:auto;
    border:1px solid var(--border); border-radius:.7rem; padding:.4rem;
    color:var(--text); background:var(--surface); box-shadow:0 12px 36px rgb(0 0 0 / 40%);
    display:grid; gap:.15rem; box-sizing:border-box;
  }
  .rail-action-list button, .rail-action-list a {
    display:block; width:100%; box-sizing:border-box; padding:.6rem; text-align:left;
    border:0; border-radius:.4rem; color:var(--text); background:transparent; font:inherit;
    font-size:.79rem; text-decoration:none; cursor:pointer;
  }
  .rail-action-list button:hover:not(:disabled), .rail-action-list a:hover { background:var(--background-soft); }
  .rail-action-list button:disabled { opacity:.55; cursor:not-allowed; }
  :global(body.has-guide-rail > main) { margin-left: 17.7rem; }
  :global(body.guide-rail-collapsed .quantum-guide-rail) { display:none !important; }
  :global(body.guide-rail-collapsed > main),
  :global(body.guide-rail-collapsed > .site-footer) { margin-left:0 !important; }
  :global(body.has-guide-rail > .site-footer) { margin-left: 17.7rem; }
  @media (max-width: 900px) {
    .quantum-guide-rail { top: 0; left: 0; width: min(85vw, 21rem); height: 100vh; border-radius: 0; z-index: 40; transform: translateX(-110%); visibility: hidden; }
    :global(body.has-guide-rail > main), :global(body.has-guide-rail > .site-footer) { margin-left: 0; }
    :global(body.guide-rail-mobile-open .quantum-guide-rail) { transform: translateX(0); visibility: visible; }
    .rail-close { display: inline-block; }
    #rail-expand-handle { display:none !important; }
  }
</style>

<script>
  const rail = document.querySelector<HTMLElement>('#quantum-guide-rail');
  const projectRoot = document.querySelector<HTMLElement>('#rail-projects');
  const recentRoot = document.querySelector<HTMLElement>('#rail-recents');
  const programmeRoot = document.querySelector<HTMLElement>('#rail-programmes');
  const promptForm = document.querySelector<HTMLFormElement>('#rail-prompt-form');
  const prompt = document.querySelector<HTMLTextAreaElement>('#rail-prompt');
  const close = document.querySelector<HTMLButtonElement>('#rail-close');
  const mobileToggle = document.querySelector<HTMLButtonElement>('#portal-guide-toggle');
  const collapse = document.querySelector<HTMLButtonElement>('#rail-collapse');
  const expandHandle = document.querySelector<HTMLButtonElement>('#rail-expand-handle');
  const searchToggle = document.querySelector<HTMLButtonElement>('#rail-search-toggle');
  const searchField = document.querySelector<HTMLElement>('#rail-search-field');
  const searchInput = document.querySelector<HTMLInputElement>('#rail-search');
  const sendButton = document.querySelector<HTMLButtonElement>('#rail-send');
  const newChat = document.querySelector<HTMLButtonElement>('#rail-new-chat');
  const chatStatus = document.querySelector<HTMLElement>('#rail-chat-status');
  const inlineTranscript = document.querySelector<HTMLElement>('#rail-inline-transcript');
  const openConversation = document.querySelector<HTMLAnchorElement>('#rail-open-conversation');

  type GuideMessage = { author_kind: string; content: unknown };
  type GuideConversation = { id: string; title?: string; messages?: GuideMessage[] };
  let railConversationId: string | null = null;
  let sending = false;

  function setDesktopCollapsed(collapsed: boolean) {
    document.body.classList.toggle('guide-rail-collapsed', collapsed);
    if (expandHandle) expandHandle.hidden = !collapsed;
    window.sessionStorage.setItem('qp:guide-collapsed', String(collapsed));
    mobileToggle?.setAttribute('aria-expanded', String(!collapsed));
    if (mobileToggle) {
      mobileToggle.title = collapsed ? 'Expand Quantum Guide' : 'Collapse Quantum Guide';
    }
  }
  function filterRail() {
    const term = searchInput?.value.trim().toLocaleLowerCase() ?? '';
    for (const root of [projectRoot, programmeRoot, recentRoot]) {
      if (!root) continue;
      for (const node of Array.from(root.children)) {
        const match = node.textContent?.toLocaleLowerCase().includes(term) ?? false;
        (node as HTMLElement).hidden = Boolean(term) && !match;
        if (term && match) {
          if (node instanceof HTMLDetailsElement) node.open = true;
          node.querySelectorAll<HTMLDetailsElement>('details.rail-folder')
            .forEach(folder => { folder.open = true; });
        }
      }
    }
  }

  function messageText(content: unknown): string {
    if (typeof content === 'string') return content;
    if (content && typeof content === 'object' && 'text' in content
      && typeof (content as { text?: unknown }).text === 'string') {
      return (content as { text: string }).text;
    }
    return JSON.stringify(content);
  }

  function cookie(name: string): string | null {
    const part = document.cookie.split('; ').find(item => item.startsWith(name + '='));
    return part ? decodeURIComponent(part.slice(name.length + 1)) : null;
  }

  async function postJson(
    path: string, payload: Record<string, unknown>,
    headers?: Record<string, string>, method: 'POST' | 'PATCH' = 'POST',
  ) {
    const csrf = await fetch('/api/v1/csrf/', {
      credentials: 'same-origin', cache: 'no-store',
    });
    if (!csrf.ok) throw new Error('Could not establish secure session.');
    const token = cookie('csrftoken');
    if (!token) throw new Error('CSRF token unavailable. Sign in again.');
    return fetch(path, {
      method, credentials: 'same-origin', cache: 'no-store',
      headers: { 'Content-Type': 'application/json', 'X-CSRFToken': token, ...headers },
      body: JSON.stringify(payload),
    });
  }

  function renderInlineMessages(messages: GuideMessage[]) {
    inlineTranscript?.replaceChildren();
    for (const message of messages.slice(-8)) {
      const item = document.createElement('div');
      item.className = 'rail-inline-message '
        + (message.author_kind === 'user' ? 'user' : 'assistant');
      const heading = document.createElement('strong');
      heading.textContent = message.author_kind === 'user' ? 'You' : 'Guide';
      const content = document.createElement('span');
      content.textContent = messageText(message.content);
      item.append(heading, content);
      inlineTranscript?.append(item);
    }
    inlineTranscript?.scrollTo({ top: inlineTranscript.scrollHeight, behavior: 'auto' });
  }

  async function refreshInlineConversation(): Promise<GuideConversation | null> {
    if (!railConversationId) return null;
    const response = await fetch('/api/v1/agent/conversations/'
      + encodeURIComponent(railConversationId) + '/', {
      credentials: 'same-origin', cache: 'no-store',
    });
    if (!response.ok) {
      if (response.status === 403 || response.status === 404) railConversationId = null;
      throw new Error('Could not load this conversation. Open full Guide to review it.');
    }
    const conversation: GuideConversation = await response.json();
    renderInlineMessages(conversation.messages ?? []);
    if (openConversation) openConversation.href = '/agent/';
    return conversation;
  }

  async function ensureInlineConversation(): Promise<string> {
    if (railConversationId) return railConversationId;
    const response = await postJson('/api/v1/agent/conversations/', { title: 'New chat' });
    const body = await response.json().catch(() => ({}));
    if (!response.ok || !body.id) throw new Error(body.detail ?? 'Could not create conversation.');
    railConversationId = body.id;
    window.sessionStorage.setItem('qp:last-conversation-id', body.id);
    return body.id;
  }

  async function pollInlineRun(conversationId: string, runId: string) {
    for (let attempt = 0; attempt < 60; attempt += 1) {
      if (railConversationId !== conversationId) return;
      const response = await fetch('/api/v1/agent/runs/' + encodeURIComponent(runId) + '/', {
        credentials: 'same-origin', cache: 'no-store',
      });
      if (!response.ok) throw new Error('Could not refresh Guide run. Open full Guide to resume.');
      const result = await response.json();
      if (result.conversation_id !== conversationId) throw new Error('Run identity mismatch.');
      if (result.status === 'succeeded') {
        await refreshInlineConversation();
        if (chatStatus) chatStatus.textContent = 'Reply saved to the conversation.';
        return;
      }
      if (result.status === 'failed') {
        await refreshInlineConversation();
        throw new Error('Guide response failed: ' + (result.failure_code ?? 'unknown error'));
      }
      if (chatStatus) chatStatus.textContent =
        result.status === 'queued' ? 'Guide queued…' : 'Guide is responding…';
      await new Promise(resolve => window.setTimeout(resolve, 1000));
    }
    if (chatStatus) chatStatus.textContent =
      'Still processing. Open full Guide to check the conversation.';
  }

  function railMenu(kind: 'project' | 'conversation' | 'programme', id: string, title: string) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'rail-actions';
    button.textContent = '⋯';
    button.title = 'Actions for ' + title;
    button.setAttribute('aria-label', button.title);
    button.setAttribute('aria-haspopup', 'menu');
    button.setAttribute('aria-expanded', 'false');
    const actions = document.createElement('div');
    actions.className = 'rail-action-list';
    actions.setAttribute('role', 'menu');
    actions.setAttribute('popover', 'auto');
    actions.addEventListener('toggle', () => {
      button.setAttribute('aria-expanded', String(actions.matches(':popover-open')));
    });
    button.addEventListener('click', () => {
      if (actions.matches(':popover-open')) { actions.hidePopover(); return; }
      actions.showPopover();
      const rect = button.getBoundingClientRect();
      const width = 216;
      const left = Math.max(8, Math.min(rect.right - width, window.innerWidth - width - 8));
      const below = window.innerHeight - rect.bottom >= Math.min(240, actions.offsetHeight + 8);
      actions.style.left = left + 'px';
      actions.style.top = (below ? rect.bottom + 4
        : Math.max(8, rect.top - actions.offsetHeight - 4)) + 'px';
    });
    const manage = document.createElement('button');
    manage.type = 'button';
    manage.textContent = kind === 'programme' ? 'View access / settings'
      : kind === 'project' ? 'Rename / archive' : 'Rename / move / archive';
    manage.addEventListener('click', () => {
      if (kind === 'programme') window.location.assign('/programmes/');
      else {
        window.sessionStorage.setItem('qp:workspace-edit', kind + ':' + id);
        window.location.assign('/agent/');
      }
    });
    actions.append(manage);
    if (kind !== 'programme') {
      const archive = document.createElement('button');
      archive.type = 'button';
      archive.textContent = 'Archive · remove from sidebar';
      archive.title = 'Retains conversation and memory records; restore in full Guide';
      archive.addEventListener('click', () => {
        actions.hidePopover();
        void (async () => {
          const collection = kind === 'project' ? 'projects' : 'conversations';
          const path = '/api/v1/agent/' + collection + '/' + encodeURIComponent(id) + '/';
          try {
            const current = await fetch(path, {
              credentials: 'same-origin', cache: 'no-store',
            });
            if (!current.ok) throw new Error('Could not load the latest workspace version.');
            const item = await current.json();
            if (!item.updated_at) throw new Error('Workspace version unavailable.');
            const response = await postJson(
              path, { archived: true },
              { 'If-Match': '"' + item.updated_at + '"' }, 'PATCH',
            );
            if (!response.ok) {
              const failure = await response.json().catch(() => ({}));
              throw new Error(failure.detail ?? 'Archive failed.');
            }
            if (chatStatus) chatStatus.textContent =
              'Archived. Use Show archived in full Guide to restore it.';
            await showRail();
          } catch (error) {
            if (chatStatus) chatStatus.textContent = error instanceof Error
              ? error.message : 'Archive failed.';
          }
        })();
      });
      actions.append(archive);
    }
    if (kind === 'project') {
      const create = document.createElement('button');
      create.type = 'button';
      create.textContent = 'New chat in project';
      create.addEventListener('click', () => {
        window.sessionStorage.setItem('qp:workspace-new-chat', id);
        window.location.assign('/agent/');
      });
      actions.append(create);
    }
    if (kind !== 'programme') {
      const pin = document.createElement('button');
      pin.type = 'button'; pin.disabled = true;
      pin.textContent = 'Pin · unavailable';
      pin.title = 'Requires reviewed ACP canonical pin support';
      actions.append(pin);
      const remove = document.createElement('button');
      remove.type = 'button'; remove.disabled = true;
      remove.textContent = 'Delete · unavailable';
      remove.title = 'Requires ACP retention, deletion and memory-source policy';
      actions.append(remove);
    } else {
      const shared = document.createElement('button');
      shared.type = 'button'; shared.disabled = true;
      shared.textContent = 'New shared chat · unavailable';
      shared.title = 'Requires PI-governed ACP programme rooms';
      actions.append(shared);
    }
    const wrapper = document.createElement('span');
    wrapper.className = 'rail-actions-wrap';
    wrapper.append(button, actions);
    return wrapper;
  }

  function chatButton(chat: { id: string; title?: string }) {
    const row = document.createElement('div');
    row.className = 'rail-chat-row';
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'rail-chat';
    button.textContent = chat.title || 'New chat';
    button.title = chat.title || 'New chat';
    button.addEventListener('click', () => {
      window.sessionStorage.setItem('qp:last-conversation-id', chat.id);
      railConversationId = chat.id;
      void refreshInlineConversation().catch(() => {
        if (chatStatus) chatStatus.textContent = 'Open full Guide to review this chat.';
      });
      if (openConversation) openConversation.href = '/agent/';
    });
    row.append(button, railMenu('conversation', chat.id, chat.title || 'New chat'));
    return row;
  }

  async function showRail() {
    if (!rail) return;
    try {
      const response = await fetch('/api/v1/me/', { credentials: 'same-origin', cache: 'no-store' });
      if (!response.ok) return;
      const me = await response.json();
      programmeRoot?.replaceChildren();
      for (const membership of (me.memberships ?? [])) {
        if (membership.status !== 'approved' || !membership.programme?.name) continue;
        const folder = document.createElement('details');
        folder.className = 'rail-folder';
        const label = document.createElement('summary');
        label.textContent = membership.programme.name;
        const link = document.createElement('a');
        link.href = '/programmes/';
        link.className = 'rail-note';
        link.textContent = 'Shared chats pending PI-governed workspaces';
        folder.append(label, link);
        const wrapper = document.createElement('div');
        wrapper.className = 'rail-folder-row';
        wrapper.append(folder, railMenu('programme',
          String(membership.programme.id ?? ''), membership.programme.name));
        programmeRoot?.append(wrapper);
      }
      rail.hidden = false;
      document.body.classList.add('has-guide-rail');
      if (mobileToggle) mobileToggle.hidden = false;
      if (window.matchMedia('(min-width: 901px)').matches) {
        setDesktopCollapsed(window.sessionStorage.getItem('qp:guide-collapsed') === 'true');
      }
      const [projectsResponse, conversationsResponse] = await Promise.all([
        fetch('/api/v1/agent/projects/', { credentials: 'same-origin', cache: 'no-store' }),
        fetch('/api/v1/agent/conversations/', { credentials: 'same-origin', cache: 'no-store' }),
      ]);
      if (!projectsResponse.ok || !conversationsResponse.ok) {
        if (projectRoot) projectRoot.textContent = 'Projects are temporarily unavailable.';
        return;
      }
      const projectPayload = await projectsResponse.json();
      const conversationPayload = await conversationsResponse.json();
      const projects: Array<{id: string; title: string; archived_at?: string | null}> = projectPayload.items ?? [];
      const chats: Array<{id: string; title?: string; project_id?: string | null; archived_at?: string | null}> = conversationPayload.items ?? [];
      if (railConversationId === null && !sending) {
        const last = window.sessionStorage.getItem('qp:last-conversation-id');
        if (last && chats.some(chat => chat.id === last)) {
          railConversationId = last;
          void refreshInlineConversation().catch(() => {
            if (chatStatus) chatStatus.textContent = 'Open full Guide to resume the last chat.';
          });
        }
      }
      projectRoot?.replaceChildren();
      recentRoot?.replaceChildren();
      for (const project of projects.filter(p => !p.archived_at).slice(0, 12)) {
        const folder = document.createElement('details');
        folder.className = 'rail-folder';
        const heading = document.createElement('summary');
        heading.textContent = project.title;
        const children = document.createElement('div');
        children.className = 'rail-folder-children';
        chats.filter(chat => chat.project_id === project.id && !chat.archived_at).slice(0, 12)
          .forEach(chat => children.append(chatButton(chat)));
        folder.append(heading, children);
        const wrapper = document.createElement('div');
        wrapper.className = 'rail-folder-row';
        wrapper.append(folder, railMenu('project', project.id, project.title));
        projectRoot?.append(wrapper);
      }
      // Recent means recently updated conversations, including those filed under projects.
      chats.filter(chat => !chat.archived_at
        && !projects.some(p => p.id === chat.project_id && p.archived_at)).slice(0, 12)
        .forEach(chat => recentRoot?.append(chatButton(chat)));
      if (!projects.length && projectRoot) projectRoot.textContent = 'No projects yet.';
      filterRail();
    } catch {
      if (rail && !rail.hidden && projectRoot) {
        projectRoot.textContent = 'Guide conversations temporarily unavailable.';
      }
    }
  }

  newChat?.addEventListener('click', () => {
    if (sending) return;
    railConversationId = null;
    inlineTranscript?.replaceChildren();
    if (chatStatus) chatStatus.textContent = 'New conversation ready. Type your question.';
    prompt?.focus();
  });

  promptForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (sending) return;
    const value = prompt?.value.trim();
    if (!value) { prompt?.focus(); return; }
    void (async () => {
      sending = true;
      if (sendButton) sendButton.disabled = true;
      if (newChat) newChat.disabled = true;
      try {
        const conversationId = await ensureInlineConversation();
        const response = await postJson(
          '/api/v1/agent/conversations/' + encodeURIComponent(conversationId) + '/turns/',
          {
            content: { text: value },
            source_channel: 'web',
            client_message_id: crypto.randomUUID(),
          },
          { 'Idempotency-Key': crypto.randomUUID() },
        );
        const body = await response.json().catch(() => ({}));
        if (!response.ok || !body.run_id) {
          throw new Error(body.detail ?? 'Could not submit Guide message.');
        }
        if (prompt) prompt.value = '';
        if (chatStatus) chatStatus.textContent = 'Guide is responding…';
        await refreshInlineConversation();
        await pollInlineRun(conversationId, body.run_id);
        void showRail();
      } catch (error) {
        if (chatStatus) chatStatus.textContent = error instanceof Error
          ? error.message : 'Guide request failed.';
      } finally {
        sending = false;
        if (sendButton) sendButton.disabled = false;
        if (newChat) newChat.disabled = false;
      }
    })();
  });

  searchToggle?.addEventListener('click', () => {
    const show = Boolean(searchField?.hidden);
    if (searchField) searchField.hidden = !show;
    searchToggle.setAttribute('aria-expanded', String(show));
    if (show) searchInput?.focus();
    else if (searchInput) { searchInput.value = ''; filterRail(); }
  });
  searchInput?.addEventListener('input', filterRail);

  const toggleGuide = () => {
    if (window.matchMedia('(max-width: 900px)').matches) {
      const opened = document.body.classList.toggle('guide-rail-mobile-open');
      mobileToggle?.setAttribute('aria-expanded', String(opened));
    } else {
      setDesktopCollapsed(!document.body.classList.contains('guide-rail-collapsed'));
    }
  };
  mobileToggle?.addEventListener('click', toggleGuide);
  collapse?.addEventListener('click', toggleGuide);
  expandHandle?.addEventListener('click', () => setDesktopCollapsed(false));
  close?.addEventListener('click', () => {
    document.body.classList.remove('guide-rail-mobile-open');
    mobileToggle?.setAttribute('aria-expanded', 'false');
  });
  void showRail();
</script>
