<button id="rail-expand-handle" type="button" hidden
  title="Expand Quantum Guide" aria-label="Expand Quantum Guide">
  <span class="rail-symbol panel" aria-hidden="true"></span> Guide
</button>
<aside id="quantum-guide-rail" class="quantum-guide-rail" aria-label="Quantum Guide" hidden>
  <div class="rail-heading">
    <a href="/agent/" class="rail-title" title="Open Quantum Guide">Quantum Guide</a>
    <div class="rail-heading-actions">
      <button type="button" id="rail-search-toggle" class="rail-tool rail-search-symbol"
        title="Search projects and chats" aria-label="Search projects and chats"
        aria-expanded="false"><span class="rail-symbol search"></span></button>
      <button type="button" id="rail-collapse" class="rail-tool"
        title="Collapse Quantum Guide" aria-label="Collapse Quantum Guide">
        <span class="rail-symbol panel"></span>
      </button>
      <button type="button" id="rail-close" class="rail-close" aria-label="Close Guide navigation">×</button>
    </div>
  </div>
  <p class="rail-subtitle">Your research assistant</p>
  <label id="rail-search-field" class="rail-search-field" hidden>
    <span class="sr-only">Find projects, programmes, conversations</span>
    <input id="rail-search" type="search" placeholder="Search your workspace…" autocomplete="off" />
  </label>
  <form id="rail-prompt-form" class="rail-prompt">
    <label for="rail-prompt">Ask Guide</label>
    <textarea id="rail-prompt" rows="3" maxlength="4000"
      placeholder="What would you like to explore or work on?"></textarea>
    <div class="rail-prompt-actions">
      <button id="rail-send" type="submit">Send</button>
      <button id="rail-new-chat" type="button" class="rail-secondary">New chat</button>
    </div>
  </form>
  <p id="rail-chat-status" class="rail-note" role="status" aria-live="polite">
    Messages are stored in your ACP conversation, not in this browser panel.
  </p>
  <div id="rail-inline-transcript" class="rail-inline-transcript" role="log"
    aria-live="polite" aria-label="Quantum Guide conversation"></div>
  <a id="rail-open-conversation" class="rail-all" href="/agent/">Open in full Guide</a>

  <div class="rail-section-title">
    <h2>Projects</h2>
    <a href="/agent/" aria-label="Manage research projects" title="Manage research projects">+</a>
  </div>
  <nav id="rail-projects" aria-label="Your research projects">
    <p class="rail-note">Loading projects…</p>
  </nav>
  <h2 class="rail-section-title">Programmes</h2>
  <nav id="rail-programmes" aria-label="Approved research programmes"></nav>
  <h2 class="rail-section-title">Recent chats</h2>
  <nav id="rail-recents" class="rail-vertical-list" aria-label="Recent research conversations"></nav>
  <a class="rail-all" href="/notebooks/">Explore scientific notebooks</a>
</aside>

<style>
  .quantum-guide-rail {
    position: fixed; z-index: 18; top: 76px; left: .5rem;
    width: 16.5rem; height: calc(100vh - 85px); overflow-y: auto;
    padding: 1rem; box-sizing: border-box;
    border: 1px solid var(--border); border-radius: .85rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .quantum-guide-rail[hidden], #rail-expand-handle[hidden] { display: none !important; }
  #rail-expand-handle { position:fixed; z-index:30; top:5.25rem; left:.5rem;
    display:flex; align-items:center; gap:.4rem; padding:.55rem .7rem;
    border:1px solid var(--border); border-radius:.65rem; color:var(--text);
    background:var(--surface); box-shadow:var(--shadow); cursor:pointer; }
  #rail-expand-handle:hover { background:var(--background-soft); }
  #rail-expand-handle .rail-symbol { background:currentColor; }
  .rail-heading { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
  .rail-heading-actions { display:flex; align-items:center; gap:.2rem; }
  .rail-tool { width:2rem; height:2rem; display:grid; place-items:center; cursor:pointer;
    background:transparent; border:1px solid transparent; border-radius:.5rem; color:var(--text); }
  .rail-tool:hover, .rail-tool:focus-visible { border-color:var(--border); background:var(--background-soft); }
  .rail-symbol { display:inline-block; width:1.15rem; height:1.15rem; background:currentColor;
    opacity:.65; mask-position:center; mask-size:contain; mask-repeat:no-repeat;
    -webkit-mask-position:center; -webkit-mask-size:contain; -webkit-mask-repeat:no-repeat; }
  .rail-symbol.search { mask-image:url('/assets/guide/search.svg');
    -webkit-mask-image:url('/assets/guide/search.svg'); }
  .rail-symbol.panel { mask-image:url('/assets/guide/panel.svg');
    -webkit-mask-image:url('/assets/guide/panel.svg'); }
  .rail-search-field { display:block; margin:.6rem 0; }
  .rail-search-field[hidden] { display:none; }
  .rail-search-field input { box-sizing:border-box; width:100%; padding:.6rem;
    border:1px solid var(--border); border-radius:.6rem; background:var(--background); color:var(--text); }
  .sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); }
  .rail-vertical-list, .quantum-guide-rail nav { display:grid; grid-template-columns:minmax(0,1fr);
    align-content:start; gap:.1rem; }
  .rail-title { text-decoration: none; color: var(--text); font-weight: 800; }
  .rail-subtitle, .rail-note { font-size: .75rem; color: var(--muted); }
  .rail-subtitle { margin: .25rem 0 .9rem; }
  .rail-prompt { display: grid; gap: .5rem; margin-bottom: .3rem; }
  .rail-prompt label { font-size: .8rem; font-weight: 700; }
  .rail-prompt textarea {
    resize: vertical; min-height: 4rem; padding: .55rem;
    border: 1px solid var(--border); border-radius: .55rem;
    color: var(--text); background: var(--background); font: inherit;
  }
  .rail-prompt button {
    padding: .6rem; border: 0; border-radius: .6rem;
    background: var(--purple-strong); color: white; cursor: pointer;
  }
  .rail-prompt-actions { display: flex; flex-wrap: wrap; gap: .4rem; }
  .rail-prompt .rail-secondary { background: var(--background); color: var(--text); border: 1px solid var(--border); }
  .rail-prompt button:disabled { opacity: .6; cursor: wait; }
  .rail-inline-transcript { max-height: min(33vh, 22rem); overflow-y: auto; display: grid;
    gap: .35rem; margin-top: .55rem; font-size: .8rem; }
  .rail-inline-message { padding: .55rem; border-radius: .5rem; overflow-wrap: anywhere;
    white-space: pre-wrap; background: var(--background); }
  .rail-inline-message.assistant { border: 1px solid var(--border); }
  .rail-inline-message.user { border: 1px solid var(--purple-strong); }
  .rail-inline-message strong { display: block; font-size: .72rem; margin-bottom: .2rem; }
  .rail-inline-transcript:empty { display: none; }
  .rail-close { display: none; border: 0; font-size: 1.2rem; background: transparent; color: var(--text); cursor: pointer; }
  .rail-section-title { margin: 1.2rem 0 .4rem; display: flex; align-items: center; justify-content: space-between; font-size: .85rem; }
  .rail-section-title h2 { font-size: inherit; margin: 0; }
  .rail-section-title a { color: var(--text); font-size: 1.1rem; text-decoration: none; }
  .rail-all { display: inline-block; margin-top: .8rem; font-size: .8rem; color: var(--muted-strong); }
  .rail-chat {
    display: flex; align-items:center; gap:.5rem; width: 100%; text-align: left; padding: .4rem .5rem;
    margin-bottom: .15rem; border: 0; border-radius: .4rem;
    background: transparent; color: var(--text); cursor: pointer;
    font: inherit; font-size: .78rem; overflow-wrap: anywhere;
  }
  .rail-chat::before { content:''; flex:0 0 1rem; height:1rem; background:currentColor; opacity:.5;
    mask:url('/assets/guide/chat.svg') center / contain no-repeat;
    -webkit-mask:url('/assets/guide/chat.svg') center / contain no-repeat; }
  .rail-chat:hover, .rail-chat:focus-visible { background: var(--background-soft); }
  .rail-folder summary { display:flex; align-items:center; gap:.5rem; list-style:none; }
  .rail-folder summary::before { content:''; flex:0 0 1rem; height:1rem;
    background:currentColor; opacity:.5; mask:url('/assets/guide/folder.svg') center / contain no-repeat;
    -webkit-mask:url('/assets/guide/folder.svg') center / contain no-repeat; }
  .rail-folder { margin: .5rem 0; }
  .rail-folder summary { font-size: .82rem; cursor: pointer; font-weight: 700; overflow-wrap: anywhere; }
  .rail-folder-children { margin-left: .8rem; border-left: 1px solid var(--border); padding-left: .25rem; }
  .rail-chat-row, .rail-folder-row { display:flex; align-items:center; min-width:0; gap:.2rem; width:100%; }
  .rail-chat-row > .rail-actions-wrap, .rail-folder-row > .rail-actions-wrap { margin-left:auto; }
  .rail-folder-row > .rail-folder { overflow:hidden; }
  .rail-folder > summary { max-width:100%; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .rail-folder > summary::before { flex-shrink:0; }
  .rail-chat-row > .rail-chat, .rail-folder-row > .rail-folder { flex:1; min-width:0; }

  .rail-actions-wrap { display:inline-flex; flex:0 0 auto; }
  .rail-actions { flex:0 0 auto; border:1px solid transparent; border-radius:.45rem;
    background:transparent; color:var(--text); cursor:pointer; min-width:1.95rem; height:1.95rem;
    display:grid; place-items:center; font-size:1rem; font-family:inherit; }
  .rail-actions:hover, .rail-actions:focus-visible { background:var(--background-soft); border-color:var(--border); }
  .rail-action-list:popover-open {
    position:fixed; inset:unset; z-index:1000; width:13.5rem; max-height:min(65vh,25rem); overflow-y:auto;
    border:1px solid var(--border); border-radius:.7rem; padding:.4rem;
    color:var(--text); background:var(--surface); box-shadow:0 12px 36px rgb(0 0 0 / 40%);
    display:grid; gap:.15rem; box-sizing:border-box;
  }
  .rail-action-list button, .rail-action-list a {
    display:block; width:100%; box-sizing:border-box; padding:.6rem; text-align:left;
    border:0; border-radius:.4rem; color:var(--text); background:transparent; font:inherit;
    font-size:.79rem; text-decoration:none; cursor:pointer;
  }
  .rail-action-list button:hover:not(:disabled), .rail-action-list a:hover { background:var(--background-soft); }
  .rail-action-list button:disabled { opacity:.55; cursor:not-allowed; }
  :global(body.has-guide-rail > main) { margin-left: 17.7rem; }
  :global(body.guide-rail-collapsed .quantum-guide-rail) { display:none !important; }
  :global(body.guide-rail-collapsed > main),
  :global(body.guide-rail-collapsed > .site-footer) { margin-left:0 !important; }
  :global(body.has-guide-rail > .site-footer) { margin-left: 17.7rem; }
  @media (max-width: 900px) {
    .quantum-guide-rail { top: 0; left: 0; width: min(85vw, 21rem); height: 100vh; border-radius: 0; z-index: 40; transform: translateX(-110%); visibility: hidden; }
    :global(body.has-guide-rail > main), :global(body.has-guide-rail > .site-footer) { margin-left: 0; }
    :global(body.guide-rail-mobile-open .quantum-guide-rail) { transform: translateX(0); visibility: visible; }
    .rail-close { display: inline-block; }
    #rail-expand-handle { display:none !important; }
  }
</style>

