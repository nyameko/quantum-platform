---
import './global.css';

interface Props {
  title: string;
  description?: string;
  siteName?: string;
  section?: 'Blog' | 'Wiki' | 'User Portal';
}

const {
  title,
  description = 'Quantum-centric supercomputing research infrastructure.',
  siteName = 'Quantum Platform',
  section,
} = Astro.props;

const links = [
  ['Blog', 'https://blog.nyameko.com'],
  ['Wiki', 'https://wiki.quantum.nyameko.com'],
  ['User Portal', 'https://users.quantum.nyameko.com'],
] as const;
---
<!doctype html>
<script is:inline>
  const saved = localStorage.getItem('theme');

  if (saved === 'light' || saved === 'dark') {
    document.documentElement.dataset.theme = saved;
  }
</script>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08080b" />
    <title>{title} · {siteName}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href={Astro.url.origin} aria-label="Quantum Platform home">
          <span class="brand-mark">A</span>
          <span>
            <strong>ASTRO</strong>
            <small>QUANTUM PLATFORM</small>
          </span>
        </a>

        <nav aria-label="Primary">
          {links.map(([label, href]) => (
            <a class:list={[{ active: section === label }]} href={href}>{label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-top">
        <div>
          <p class="footer-brand">ASTRO</p>
          <p class="footer-copy">Quantum computing infrastructure for research, engineering and open collaboration.</p>
        </div>
        <div class="footer-links">
          <a href="https://github.com/nyameko/quantum-platform">GitHub</a>
          <a href="https://github.com/nyameko/quantum-platform">Support the project</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>Nyameko · Open research platform</span>
        <span>© {new Date().getFullYear()}</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgb(41 38 50 / 85%);
    background: rgb(8 8 11 / 82%);
    backdrop-filter: blur(18px);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 68px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid rgb(167 139 250 / 35%);
    border-radius: 0.55rem;
    background: linear-gradient(135deg, rgb(139 92 246 / 28%), rgb(143 36 48 / 18%));
    color: var(--purple);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .brand span:last-child {
    display: grid;
    line-height: 1;
  }

  .brand strong {
    font-size: 0.78rem;
    letter-spacing: 0.18em;
  }

  .brand small {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.48rem;
    letter-spacing: 0.18em;
  }

  nav {
    display: flex;
    gap: 0.25rem;
  }

  nav a {
    padding: 0.5rem 0.7rem;
    border: 1px solid transparent;
    border-radius: 0.55rem;
    color: var(--muted);
    font-size: 0.82rem;
    text-decoration: none;
  }

  nav a:hover,
  nav a.active {
    border-color: var(--border);
    background: rgb(255 255 255 / 3%);
    color: var(--text);
  }

  .site-footer {
    margin-top: 7rem;
    border-top: 1px solid var(--border);
    background: var(--background-soft);
  }

  .footer-top,
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-top {
    padding: 3.5rem 0;
  }

  .footer-brand {
    margin: 0;
    color: var(--purple);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .footer-copy {
    max-width: 32rem;
    margin: 0.75rem 0 0;
    color: var(--muted);
  }

  .footer-links {
    display: flex;
    align-items: start;
    gap: 1rem;
  }

  .footer-links a {
    color: var(--muted-strong);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--text);
  }

  .footer-bottom {
    padding: 1rem 0;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.78rem;
  }

  @media (max-width: 700px) {
    .nav {
      min-height: 60px;
    }

    nav a {
      padding-inline: 0.45rem;
    }

    .footer-top,
    .footer-bottom {
      flex-direction: column;
    }
  }
</style>
